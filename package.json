{
  "name": "juancespedes.dev",
  "type": "module",
  "version": "1.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm og && astro dev",
    "build": "pnpm og && astro build && node scripts/security-headers.mjs",
    "og": "node scripts/generate-og.mjs",
    "ascii": "node scripts/generate-ascii.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "new:project": "node scripts/new-project.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "astro sync && eslint . --max-warnings=0 && node scripts/check-tokens.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid > docs/dependency-graph.mmd",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:mutation": "stryker run",
    "eval:chat": "pnpm build && vitest run --config vitest.eval.config.ts",
    "lighthouse": "lhci autorun",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch:check && pnpm test:coverage && pnpm build && pnpm bundle:check && pnpm pages:check",
    "prepare": "git config core.hooksPath .githooks || true",
    "bundle:check": "node scripts/check-bundle.mjs",
    "lighthouse:local": "node scripts/lighthouse-local.mjs",
    "pages:check": "node scripts/check-pages.mjs",
    "dist:compare": "node scripts/compare-dist.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@astrojs/cloudflare": "^14.4.1",
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^7.1.0",
    "@fontsource/fragment-mono": "5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.14.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@stryker-mutator/api": "10.0.0",
    "@stryker-mutator/core": "10.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "simple-icons": "16.35.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "handlebars@<4.7.10": "^4.7.10",
      "qs@<6.15.2": "^6.15.2",
      "tmp@<0.2.6": "^0.2.6",
      "uuid@<11.1.1": "^11.1.1",
      "undici@>=7.0.0 <7.30.1": "^7.30.1",
      "undici@>=8.0.0 <8.12.2": "^8.12.2"
    }
  },
  "private": true,
  "description": "Portfolio of Juan Céspedes: full-stack, data and automation engineering. Built in public with a layered architecture.",
  "license": "MIT",
  "author": "Juan Céspedes (https://github.com/juanpacj-wq)",
  "repository": {
    "type": "git",
    "url": "https://github.com/juanpacj-wq/juancespedes.dev.git"
  },
  "packageManager": "pnpm@10.34.7"
}
