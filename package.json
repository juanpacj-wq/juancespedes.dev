{
  "name": "juancespedes.dev",
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "new:project": "node scripts/new-project.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "astro sync && eslint . --max-warnings=0 && node scripts/check-tokens.mjs",
    "typecheck": "astro check && tsc --noEmit",
    "arch:check": "depcruise src --config .dependency-cruiser.cjs",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid > docs/dependency-graph.mmd",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch:check && pnpm test:coverage && pnpm build && pnpm bundle:check",
    "prepare": "git config core.hooksPath .githooks || true",
    "bundle:check": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.4",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0",
    "yaml": "^2.9.1"
  },
  "private": true,
  "description": "Portfolio of Juan Céspedes: full-stack, data and automation engineering. Built in public with a layered architecture.",
  "license": "MIT",
  "author": "Juan Céspedes (https://github.com/juanpacj-wq)",
  "repository": {
    "type": "git",
    "url": "https://github.com/juanpacj-wq/juancespedes.dev.git"
  },
  "packageManager": "pnpm@10.34.7"
}
