# Copy to .dev.vars for local development with Wrangler. Never commit real values.
# Production values live in Cloudflare (Workers > Settings > Variables and Secrets).

# Public site URL, used for canonical links, sitemap and Open Graph.
PUBLIC_SITE_URL=http://localhost:4321

# Version label exposed by GET /api/health. CI sets it to the git commit SHA.
APP_VERSION=dev

# Contact form (phase F3). Delivery uses the CONTACT_EMAIL send_email binding (wrangler.jsonc).
# Turnstile test keys from Cloudflare's docs always pass; use them locally and in CI only.
# Production: real site key as a build variable, real secret via `wrangler secret put`.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CONTACT_FROM_EMAIL=contacto@juancespedes.dev
CONTACT_TO_EMAIL=juanpablocespedesj@gmail.com

# "Ask me" chat (ADR 0017). Local runs and tests use the free fake model; never put a real
# Anthropic key here. Production sets CHAT_MODEL=anthropic in wrangler.jsonc and the key with
# `wrangler secret put ANTHROPIC_API_KEY`.
CHAT_ENABLED=true
CHAT_MODEL=fake
