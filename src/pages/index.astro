---
import { DEFAULT_LOCALE } from '../domain/shared/locale';
import { dictionaryFor } from '../ui/i18n/dictionary';
import BaseLayout from '../ui/layouts/BaseLayout.astro';
import Badge from '../ui/primitives/Badge.astro';
import Button from '../ui/primitives/Button.astro';
import Container from '../ui/primitives/Container.astro';
import Portrait from '../ui/primitives/Portrait.astro';

const locale = DEFAULT_LOCALE;
const t = dictionaryFor(locale);
---

<BaseLayout
  title={`${t.profile.name} | ${t.profile.role}`}
  description={t.meta.defaultDescription}
  locale={locale}
>
  <Container class="grid gap-12 py-16 sm:py-24 lg:grid-cols-[1fr_22rem] lg:items-end lg:gap-16">
    <div class="flex flex-col gap-6">
      <Badge tone="success" status>
        {t.availability.available}
      </Badge>
      <h1 class="text-display font-semibold text-balance">{t.profile.name}</h1>
      <p class="max-w-2xl font-mono text-title text-muted">{t.profile.role}</p>
      <p class="max-w-prose text-lead text-muted">{t.home.buildingInPublic}</p>
      <div class="flex flex-wrap gap-3">
        <Button href="mailto:juanpablocespedesj@gmail.com" icon="mail" size="lg">
          juanpablocespedesj@gmail.com
        </Button>
        <Button
          href="https://github.com/juanpacj-wq"
          variant="secondary"
          icon="github"
          size="lg"
          external
          externalLabel={t.a11y.external}
        >
          GitHub
        </Button>
      </div>
    </div>
    <Portrait alt={t.profile.portraitAlt} initials="JC" priority class="max-w-sm" />
  </Container>
</BaseLayout>
