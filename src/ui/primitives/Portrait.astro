---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * The owner's portrait at a fixed 4:5 ratio, so the layout never shifts when the photo loads.
 * Uses src/assets/photos/portrait.{jpg,jpeg,png,webp} when it exists (optimized to AVIF and
 * WebP at build time); until then, renders a monogram placeholder. Swapping the photo is
 * dropping the file in place: no code changes.
 */
interface Props {
  alt: string;
  initials: string;
  priority?: boolean;
  class?: string;
}

const { alt, initials, priority = false, class: className } = Astro.props;

const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/photos/portrait.{jpg,jpeg,png,webp}',
  { eager: true },
);
const photo = Object.values(photos)[0]?.default;
---

<div
  class:list={[
    'relative aspect-4/5 w-full overflow-hidden rounded-frame bg-frame shadow-bevel',
    className,
  ]}
>
  {photo ? (
    <Picture
      src={photo}
      alt={alt}
      formats={['avif', 'webp']}
      widths={[320, 480, 640, 960]}
      sizes="(min-width: 1024px) 24rem, (min-width: 640px) 50vw, 90vw"
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="size-full object-cover"
    />
  ) : (
    <div role="img" aria-label={alt} class="portrait-placeholder grid size-full place-items-center">
      <span class="font-display text-display font-light text-ink/70" aria-hidden="true">
        {initials}
      </span>
    </div>
  )}
</div>

<style>
  /* Placeholder: a single warm light falling on the monogram, built only from color tokens. */
  .portrait-placeholder {
    background-image: radial-gradient(
      90% 70% at 30% 20%,
      color-mix(in srgb, var(--color-accent) 16%, transparent),
      transparent 65%
    );
  }
</style>
