---
/**
 * Raised surface with a bevelled edge instead of a border (ADR 0018). `interactive` adds a
 * slight scale for cards that are entirely a link; the link itself goes inside the slot so the
 * accessible name stays meaningful.
 */
interface Props {
  as?: 'div' | 'article' | 'li';
  interactive?: boolean;
  padding?: 'md' | 'lg';
  class?: string;
}

const { as: Tag = 'div', interactive = false, padding = 'md', class: className } = Astro.props;
---

<Tag
  class:list={[
    'relative rounded-card bg-surface shadow-bevel',
    padding === 'md' ? 'p-5 sm:p-6' : 'p-6 sm:p-8',
    interactive &&
      'transition-[background-color,scale] duration-500 ease-out hover:bg-surface-raised focus-within:bg-surface-raised motion-safe:hover:scale-101',
    className,
  ]}
>
  <slot />
</Tag>
