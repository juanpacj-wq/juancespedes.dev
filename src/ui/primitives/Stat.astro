---
/**
 * A headline figure. The source is always printed: every number on the site can be traced.
 * Values are passed already localized (e.g. "1.400+" in Spanish, "1,400+" in English).
 */
interface Props {
  value: string;
  label: string;
  source: string;
  sourceLabel: string;
  size?: 'md' | 'lg';
  class?: string;
}

const { value, label, source, sourceLabel, size = 'md', class: className } = Astro.props;
---

<figure class:list={['flex h-full flex-col gap-3', className]}>
  <p
    class:list={[
      'font-display font-medium tabular-nums text-ink',
      size === 'lg' ? 'text-display' : 'text-heading',
    ]}
  >
    {value}
  </p>
  <figcaption class="flex flex-1 flex-col justify-between gap-4">
    <span class:list={[size === 'lg' ? 'text-lead' : 'text-small', 'text-muted']}>{label}</span>
    <span class="font-mono text-eyebrow text-subtle">
      {sourceLabel}: {source}
    </span>
  </figcaption>
</figure>
