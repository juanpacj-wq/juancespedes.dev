---
import Container from './Container.astro';

/**
 * A titled page section. The header is one line across the page: a hairline on top, a short
 * title on the left and, when the section needs one, a brief note on the right (ADR 0029). The
 * heading level is configurable so the page outline stays correct wherever the section is used.
 * The optional eyebrow is reserved for reference pages whose sections really are a sequence (the
 * design system); the home page does not label every section (ADR 0018).
 */
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  level?: 2 | 3;
  class?: string;
}

const { id, eyebrow, title, level = 2, class: className } = Astro.props;
const Heading = `h${String(level)}` as 'h2' | 'h3';
const headingId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={['scroll-mt-24 py-20 sm:py-28', className]}
>
  <Container>
    <header class="reveal mb-10 grid gap-4 border-t border-line pt-6 sm:mb-14 lg:grid-cols-12 lg:gap-10">
      <div class="flex flex-col gap-3 lg:col-span-8">
        {eyebrow && (
          <p class="font-mono text-eyebrow tracking-widest text-accent-ink uppercase">{eyebrow}</p>
        )}
        <Heading id={headingId} class="font-display text-heading font-medium text-balance">
          {title}
        </Heading>
      </div>
      {Astro.slots.has('description') && (
        <div class="max-w-md text-body text-pretty text-muted lg:col-span-4 lg:justify-self-end lg:pt-2">
          <slot name="description" />
        </div>
      )}
    </header>
    <slot />
  </Container>
</section>
