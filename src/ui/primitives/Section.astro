---
import Container from './Container.astro';

/**
 * A titled page section with a serif heading. The heading level is configurable so the page
 * outline stays correct wherever the section is used. The optional eyebrow is reserved for
 * reference pages whose sections really are a sequence (the design system); the home page does
 * not label every section (ADR 0018).
 */
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  level?: 2 | 3;
  class?: string;
}

const { id, eyebrow, title, level = 2, class: className } = Astro.props;
const Heading = `h${String(level)}` as 'h2' | 'h3';
const headingId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={['scroll-mt-24 py-20 sm:py-28', className]}
>
  <Container>
    <header class="reveal mb-12 max-w-3xl">
      {eyebrow && (
        <p class="mb-3 font-mono text-eyebrow tracking-widest text-accent-ink uppercase">
          {eyebrow}
        </p>
      )}
      <Heading id={headingId} class="font-display text-heading font-light text-balance">
        {title}
      </Heading>
      {Astro.slots.has('description') && (
        <div class="mt-5 max-w-2xl text-lead text-pretty text-muted">
          <slot name="description" />
        </div>
      )}
    </header>
    <slot />
  </Container>
</section>
