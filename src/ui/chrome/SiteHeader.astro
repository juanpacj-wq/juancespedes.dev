---
import type { Locale } from '../../domain/shared/locale';
import type { Dictionary } from '../i18n/dictionary';
import Icon from '../icons/Icon.astro';
import Container from '../primitives/Container.astro';
import CommandPalette from './CommandPalette.astro';
import type { NavItem } from './nav';
import RollingLabel from './RollingLabel.astro';

export type { NavItem };

interface Props {
  t: Dictionary;
  homeHref: string;
  navItems?: readonly NavItem[] | undefined;
  /** The same page in the other language; absent on pages that exist in one language only. */
  switchTo?: { readonly href: string; readonly locale: Locale } | null;
  /** Label of the button that opens the floating chat; null when the chat is off. */
  chatLabel?: string | null;
}

const { t, homeHref, navItems = [], switchTo = null, chatLabel = null } = Astro.props;
---

<header class="site-header sticky top-0 z-40 border-b border-line/60 bg-canvas/80 backdrop-blur-md supports-[backdrop-filter]:bg-canvas/70">
  <Container class="flex h-16 items-center justify-between gap-4">
    <a
      href={homeHref}
      aria-label="juancespedes.dev"
      class="font-mono text-small tracking-tight text-ink"
      data-scramble
    >
      <span data-scramble-text>juancespedes</span>
      <span class="text-accent-ink">.dev</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-4">
      {navItems.length > 0 && (
        <nav aria-label={t.a11y.mainNavigation} class="hidden md:block">
          <ul class="nav-list text-small text-muted" data-nav>
            <li class="nav-pill" aria-hidden="true" data-nav-pill></li>
            {navItems.map((item) =>
              item.menu ? (
                <li class="nav-menu" data-nav-menu>
                  <a href={item.href} class="nav-link">
                    <RollingLabel text={item.label} />
                  </a>
                  <button
                    type="button"
                    class="nav-menu-toggle"
                    aria-expanded="false"
                    aria-controls="projects-menu"
                    aria-label={t.projects.menuToggle}
                    data-nav-menu-toggle
                  >
                    <Icon name="chevron-down" size={14} />
                  </button>
                  <div
                    id="projects-menu"
                    class="nav-menu-panel"
                    role="region"
                    aria-label={t.projects.menu}
                    data-nav-menu-panel
                    hidden
                  >
                    <div class="nav-menu-areas">
                      {item.menu.map((area) => (
                        <div class="nav-menu-area">
                          <a
                            href={area.href}
                            class="nav-menu-head"
                            data-work-goto={area.id}
                            data-menu-preview={area.projects[0]?.slug}
                          >
                            {area.label}
                            <span class="nav-menu-count" aria-hidden="true">
                              {area.projects.length}
                            </span>
                          </a>
                          <ul class="nav-menu-projects">
                            {area.projects.map((project) => (
                              <li>
                                <a
                                  href={project.href}
                                  class="nav-menu-project"
                                  data-menu-preview={project.slug}
                                >
                                  {project.name}
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                    {/* One screen at a time: the project under the pointer or the focus. */}
                    <div class="nav-menu-preview" aria-hidden="true">
                      <div class="nav-menu-screen">
                        {item.menu.flatMap((area) =>
                          area.projects.map(
                            (project) =>
                              project.shot && (
                                <img
                                  data-src={project.shot.src}
                                  data-preview={project.slug}
                                  width={project.shot.width}
                                  height={project.shot.height}
                                  alt=""
                                  decoding="async"
                                />
                              ),
                          ),
                        )}
                      </div>
                      {item.menu.flatMap((area) =>
                        area.projects.map((project) => (
                          <p class="nav-menu-caption" data-preview={project.slug}>
                            {project.title}
                          </p>
                        )),
                      )}
                    </div>
                  </div>
                </li>
              ) : (
                <li>
                  <a href={item.href} class="nav-link">
                    <RollingLabel text={item.label} />
                  </a>
                </li>
              ),
            )}
            {chatLabel && (
              <li>
                <button
                  type="button"
                  class="nav-link"
                  aria-expanded="false"
                  aria-controls="chat-panel"
                  data-chat-open
                >
                  <RollingLabel text={chatLabel} />
                </button>
              </li>
            )}
          </ul>
        </nav>
      )}
      <CommandPalette t={t} />
      {switchTo && (
        <a
          href={switchTo.href}
          hreflang={switchTo.locale}
          lang={switchTo.locale}
          class="nav-link inline-flex min-h-11 min-w-11 items-center justify-center rounded-control font-mono text-small text-muted"
        >
          <RollingLabel text={t.language.short} />
          <span class="sr-only">: {t.language.switchTo}</span>
        </a>
      )}
    </div>
  </Container>
</header>

<script>
  // One module file for the header instead of inline script on every
  // page (the HTML budget).
  import { mountSiteHeader } from './site-header';

  mountSiteHeader();
</script>

<style>
  /* Over the home backdrop the bar starts clear, so the painting reaches the top of the screen,
     and turns solid as the page scrolls. Without scroll timelines it simply stays solid. */
  @supports (animation-timeline: scroll()) {
    :global(body:has([data-ascii-stage])) .site-header {
      animation: header-solid linear both;
      animation-timeline: scroll(root);
      animation-range: 0 40vh;
    }
  }

  @keyframes header-solid {
    from {
      border-color: transparent;
      background-color: transparent;
      backdrop-filter: none;
    }
  }
</style>
