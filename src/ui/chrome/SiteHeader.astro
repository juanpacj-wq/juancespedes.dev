---
import type { Locale } from '../../domain/shared/locale';
import type { Dictionary } from '../i18n/dictionary';
import Container from '../primitives/Container.astro';
import CommandPalette from './CommandPalette.astro';
import ThemeToggle from './ThemeToggle.astro';

export interface NavItem {
  readonly href: string;
  readonly label: string;
}

interface Props {
  t: Dictionary;
  homeHref: string;
  navItems?: readonly NavItem[] | undefined;
  /** The same page in the other language; absent on pages that exist in one language only. */
  switchTo?: { readonly href: string; readonly locale: Locale } | null;
  /** Label of the button that opens the floating chat; null when the chat is off. */
  chatLabel?: string | null;
}

const { t, homeHref, navItems = [], switchTo = null, chatLabel = null } = Astro.props;
---

<header class="site-header sticky top-0 z-40 border-b border-line/60 bg-canvas/80 backdrop-blur-md supports-[backdrop-filter]:bg-canvas/70">
  <Container class="flex h-16 items-center justify-between gap-4">
    <a
      href={homeHref}
      class="font-mono text-small font-medium tracking-tight text-ink transition-colors hover:text-accent-ink"
    >
      juancespedes<span class="text-accent-ink">.dev</span>
    </a>
    <div class="flex items-center gap-1 sm:gap-4">
      {navItems.length > 0 && (
        <nav aria-label={t.a11y.mainNavigation} class="hidden md:block">
          <ul class="flex items-center gap-6 text-small text-muted">
            {navItems.map((item) => (
              <li>
                <a href={item.href} class="transition-colors hover:text-ink">
                  {item.label}
                </a>
              </li>
            ))}
            {chatLabel && (
              <li>
                <button
                  type="button"
                  class="transition-colors hover:text-ink"
                  aria-expanded="false"
                  aria-controls="chat-panel"
                  data-chat-open
                >
                  {chatLabel}
                </button>
              </li>
            )}
          </ul>
        </nav>
      )}
      <CommandPalette t={t} />
      {switchTo && (
        <a
          href={switchTo.href}
          hreflang={switchTo.locale}
          lang={switchTo.locale}
          class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-control font-mono text-small text-muted transition-colors hover:text-ink"
        >
          <span>{t.language.short}</span>
          <span class="sr-only">: {t.language.switchTo}</span>
        </a>
      )}
      <ThemeToggle toLightLabel={t.theme.toLight} toDarkLabel={t.theme.toDark} />
    </div>
  </Container>
</header>

<style>
  /* Over the home backdrop the bar starts clear, so the painting reaches the top of the screen,
     and turns solid as the page scrolls. Without scroll timelines it simply stays solid. */
  @supports (animation-timeline: scroll()) {
    :global(body:has([data-ascii-stage])) .site-header {
      animation: header-solid linear both;
      animation-timeline: scroll(root);
      animation-range: 0 40vh;
    }
  }

  @keyframes header-solid {
    from {
      border-color: transparent;
      background-color: transparent;
      backdrop-filter: none;
    }
  }
</style>
