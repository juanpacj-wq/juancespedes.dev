---
import type { Dictionary } from '../i18n/dictionary';
import Container from '../primitives/Container.astro';
import TextLink from '../primitives/TextLink.astro';

interface Props {
  t: Dictionary;
  repositoryUrl: string;
  privacyHref: string;
}

const { t, repositoryUrl, privacyHref } = Astro.props;
---

<footer class="border-t border-line py-10">
  <Container class="flex flex-col gap-4 text-small text-muted sm:flex-row sm:items-center sm:justify-between">
    <p>
      {t.footer.builtInPublic}{' '}
      <TextLink href={repositoryUrl} external externalLabel={t.a11y.external}>
        {t.footer.sourceCode}
      </TextLink>
      {' · '}
      <TextLink href={privacyHref}>{t.footer.privacy}</TextLink>
    </p>
    <p class="text-small text-subtle">{t.footer.rights}</p>
  </Container>
</footer>
