---
import Icon from '../icons/Icon.astro';

/**
 * Light/dark switch. Plain DOM script on purpose: shipping a UI framework runtime for one
 * button would cost more than the whole page (see ADR 0009). The choice persists in
 * localStorage; the inline script in BaseLayout applies it before first paint.
 */
interface Props {
  toLightLabel: string;
  toDarkLabel: string;
}

const { toLightLabel, toDarkLabel } = Astro.props;
---

<button
  type="button"
  class="theme-toggle inline-flex size-11 items-center justify-center rounded-control text-muted transition-colors duration-150 hover:bg-surface-raised hover:text-ink"
  data-to-light={toLightLabel}
  data-to-dark={toDarkLabel}
  aria-label={toLightLabel}
>
  <Icon name="sun" class="theme-icon-sun" />
  <Icon name="moon" class="theme-icon-moon" />
</button>

<style>
  :global(:root[data-theme='light']) .theme-toggle :global(.theme-icon-sun),
  :global(:root:not([data-theme='light'])) .theme-toggle :global(.theme-icon-moon) {
    display: none;
  }
</style>

<script>
  const STORAGE_KEY = 'theme';

  const current = (): 'light' | 'dark' =>
    document.documentElement.dataset['theme'] === 'light' ? 'light' : 'dark';

  const label = (button: HTMLButtonElement): void => {
    const next = current() === 'dark' ? button.dataset['toLight'] : button.dataset['toDark'];
    if (next) button.setAttribute('aria-label', next);
  };

  for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle')) {
    label(button);
    button.addEventListener('click', () => {
      const next = current() === 'dark' ? 'light' : 'dark';
      document.documentElement.dataset['theme'] = next;
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        // Storage can be unavailable (private mode); the theme still applies for this page.
      }
      label(button);
    });
  }
</script>
