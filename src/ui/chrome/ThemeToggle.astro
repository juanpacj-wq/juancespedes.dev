---
import Icon from '../icons/Icon.astro';

/**
 * Light/dark switch. Its behaviour is `mountThemeToggle` in site-header.ts, the header's one
 * script: plain DOM on purpose, since a UI framework runtime for one button would cost more than
 * the whole page (see ADR 0009). The choice persists in localStorage; the inline script in
 * BaseLayout applies it before first paint.
 */
interface Props {
  toLightLabel: string;
  toDarkLabel: string;
}

const { toLightLabel, toDarkLabel } = Astro.props;
---

<button
  type="button"
  class="theme-toggle inline-flex size-11 items-center justify-center rounded-control text-muted transition-colors duration-150 hover:bg-surface-raised hover:text-ink"
  data-to-light={toLightLabel}
  data-to-dark={toDarkLabel}
  aria-label={toLightLabel}
>
  <Icon name="sun" class="theme-icon-sun" />
  <Icon name="moon" class="theme-icon-moon" />
</button>

<style>
  :global(:root[data-theme='light']) .theme-toggle :global(.theme-icon-sun),
  :global(:root:not([data-theme='light'])) .theme-toggle :global(.theme-icon-moon) {
    display: none;
  }
</style>
