---
import type { Achievement } from '../../domain/project/achievement';
import type { Locale } from '../../domain/shared/locale';
import { projectPath } from '../i18n/routes';
import Icon from '../icons/Icon.astro';

/**
 * One result: the figure, the sentence a manager would repeat and where it happened. The story,
 * the chart and the source live in the case study, which the whole item opens when it is
 * published (ADR 0029 trims what ADR 0025 put on the home page).
 */
interface Props {
  locale: Locale;
  achievement: Achievement;
}

const { locale, achievement } = Astro.props;
const href = achievement.project === null ? null : projectPath(locale, achievement.project);
---

<li class="reveal group relative flex flex-col gap-3 border-t border-line pt-6 has-[.impact-link:focus-visible]:outline-2 has-[.impact-link:focus-visible]:outline-offset-4 has-[.impact-link:focus-visible]:outline-accent-ink">
  <p class="font-display text-heading leading-none font-medium text-ink tabular-nums transition-colors group-hover:text-accent-ink">
    {achievement.value}
  </p>
  <h3 class="max-w-xs text-body font-medium text-balance text-ink">
    {href === null ? (
      achievement.title
    ) : (
      <a href={href} class="impact-link after:absolute after:inset-0 focus-visible:outline-none">
        {achievement.title}
      </a>
    )}
  </h3>
  <p class="mt-auto flex items-center gap-1.5 font-mono text-eyebrow text-subtle">
    {achievement.context}
    {href !== null && (
      <Icon
        name="arrow-up-right"
        size={14}
        class="transition-transform duration-300 ease-out motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
      />
    )}
  </p>
</li>
