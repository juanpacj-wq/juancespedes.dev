---
import { barShares, type AchievementChart, type Amount } from '../../domain/project/achievement';
import type { Dictionary } from '../i18n/dictionary';

/**
 * The small chart under an achievement's figure. Every number is printed as text next to its
 * label, so the bars are decoration (aria-hidden) and the chart reads the same without them.
 * Bar lengths are shares of the largest amount in the chart, so they compare honestly; an amount
 * above zero keeps a visible sliver even when it is tiny next to the largest one. The bars grow
 * as the card scrolls in (src/ui/styles/impact.css, deferred with the card styles).
 */
interface Props {
  t: Dictionary;
  chart: AchievementChart;
  tone: 'accent' | 'success';
}

const { t, chart, tone } = Astro.props;

const percent = (share: number): string => `${(share * 100).toFixed(2)}%`;
const fill = tone === 'success' ? 'bg-success' : 'bg-accent';

const rows = (amounts: readonly Amount[]) => {
  const shares = barShares(amounts.map((item) => item.amount));
  return amounts.map((item, index) => ({ ...item, share: shares[index] ?? 0 }));
};
const compared = chart.kind === 'compare' ? rows([chart.before, chart.after]) : [];
const items = chart.kind === 'breakdown' ? rows(chart.items) : [];
---

{chart.kind === 'compare' && (
  <dl class="flex flex-col gap-3">
    {compared.map((row, index) => (
      <div class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-3 gap-y-1.5">
        <dt class="text-small text-muted">{row.label}</dt>
        <dd
          class:list={[
            'font-mono text-small tabular-nums',
            index === 1 ? 'font-medium text-ink' : 'text-subtle',
          ]}
        >
          {row.display}
        </dd>
        <dd aria-hidden="true" class="col-span-2 h-2 overflow-hidden rounded-chip bg-line">
          {row.amount > 0 && (
            <span
              class:list={[
                'impact-bar block h-full w-[max(var(--share),0.375rem)] rounded-chip',
                index === 1 ? fill : 'bg-line-strong',
              ]}
              style={`--share: ${percent(row.share)}`}
            />
          )}
        </dd>
      </div>
    ))}
  </dl>
)}

{chart.kind === 'breakdown' && (
  <dl class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2.5">
    {items.map((row) => (
      <div class="contents">
        <dt class="text-small text-muted">{row.label}</dt>
        <dd aria-hidden="true" class="h-2 overflow-hidden rounded-chip bg-line">
          {row.amount > 0 && (
            <span
              class:list={['impact-bar block h-full w-(--share) rounded-chip', fill]}
              style={`--share: ${percent(row.share)}`}
            />
          )}
        </dd>
        <dd
          class:list={[
            'text-right font-mono text-small tabular-nums',
            row.amount > 0 ? 'font-medium text-ink' : 'text-subtle',
          ]}
        >
          {row.display}
        </dd>
      </div>
    ))}
  </dl>
)}

{chart.kind === 'progress' && (
  <div class="flex flex-col gap-2">
    <p class="text-small text-muted">
      <span class="font-mono font-medium text-ink tabular-nums">
        {chart.done} {t.impact.of} {chart.total}
      </span>{' '}
      {chart.label}
    </p>
    <div aria-hidden="true" class="impact-bar flex h-2 gap-0.5">
      {Array.from({ length: chart.total }, (_, index) => (
        <span
          class:list={[
            'h-full flex-1 first:rounded-l-chip last:rounded-r-chip',
            index < chart.done ? fill : 'bg-line',
          ]}
        />
      ))}
    </div>
  </div>
)}
