---
import { getImage } from 'astro:assets';

import painting from '../../assets/art/narcissus.jpg';
import art from '../../assets/art/narcissus.txt?raw';
import type { Locale } from '../../domain/shared/locale';
import { formatNumber } from '../i18n/format';

/**
 * Caravaggio's Narcissus as text (generated by scripts/generate-ascii.mjs). Two copies of the
 * same characters are stacked: one in the ochre ink, and one filled with the painting itself
 * (background-clip: text) that a lamp reveals around the pointer and a click floods across the
 * whole figure. The effect is the reference's WebGL shader rebuilt with text and CSS: no
 * canvas, no library, about 1 kB of script (ADR 0018).
 */
interface Props {
  locale: Locale;
  alt: string;
  caption: string;
  characters: string;
  lightOn: string;
  lightOff: string;
  class?: string;
}

const { locale, alt, caption, characters, lightOn, lightOff, class: className } = Astro.props;

const text = art.replace(/\n+$/, '');
const count = text.replace(/\s/g, '').length;
const lines = text.split('\n');
const columns = lines[0]?.length ?? 120;
// Width over height of the drawing: cells are 0.618 wide for each 1 of height (Fragment Mono).
const ratio = (columns * 0.618) / lines.length;
// The colour layer only needs one pixel per character, so a tiny copy of the painting is enough.
// It is fetched on first use (see the script), never with the page.
const colour = await getImage({ src: painting, width: columns, format: 'webp' });
const countLabel = characters.replace('{count}', formatNumber(locale, count));
---

<figure class:list={['ascii-art', className]} style={`--ratio: ${ratio.toFixed(4)}`} data-ascii>
  <div
    class="ascii-canvas"
    role="img"
    aria-label={alt}
    style={`--columns: ${String(columns)}`}
    data-painting={colour.src}
  >
    <pre class="ascii-layer ascii-ink" aria-hidden="true">{text}</pre>
    <!-- Filled from the ink on first use, so the page carries the text once. -->
    <pre class="ascii-layer ascii-paint" aria-hidden="true"></pre>
  </div>
  <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 font-mono text-eyebrow text-subtle">
    <span>
      {caption} · {countLabel}
    </span>
    <button
      type="button"
      class="ascii-switch group inline-flex min-h-11 items-center gap-2 rounded-chip text-muted transition-colors duration-150 hover:text-ink"
      aria-pressed="false"
      data-on={lightOn}
      data-off={lightOff}
    >
      <span
        class="ascii-bulb size-2 rounded-chip bg-line-strong group-aria-pressed:bg-accent"
        aria-hidden="true"
      ></span>
      <span class="ascii-switch-label">{lightOn}</span>
    </button>
  </figcaption>
</figure>

<style>
  /* Registered so the lamp radius and the flood can transition smoothly. */
  @property --lamp {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  @property --flood {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 0%;
  }

  /* --ratio (width over height) lets a parent size the figure by the height it has. The size
     container is the drawing, not the figure, so a parent can also place the caption. */

  .ascii-canvas {
    --x: 38%;
    --y: 40%;
    position: relative;
    container-type: inline-size;
    transition:
      --lamp 400ms var(--ease-out),
      --flood 1400ms var(--ease-out);
  }

  .ascii-layer {
    margin: 0;
    /* Fragment Mono advances 0.618em per character: this fits every column in the figure's
       width. */
    font-family: var(--font-mono);
    /* The glyph ramp was measured at this weight (scripts/generate-ascii.mjs). */
    font-weight: 400;
    font-size: calc(100cqi / (var(--columns) * 0.618));
    line-height: 1;
    letter-spacing: 0;
    white-space: pre;
    user-select: none;
  }

  /* The ink steps aside wherever the painting shows through: under the lamp, and everywhere
     once the light is on. Masks cost a repaint of every glyph, so they only apply while the lamp
     or the light is in use; at rest both layers are plain text. */
  .ascii-ink {
    color: var(--color-ascii);
    transition: opacity 1200ms var(--ease-out);
  }

  .ascii-canvas[data-lamp] .ascii-ink {
    mask-image: radial-gradient(circle var(--lamp) at var(--x) var(--y), transparent 35%, black);
  }

  .ascii-canvas[data-lit] .ascii-ink {
    opacity: 0;
  }

  .ascii-paint {
    position: absolute;
    inset: 0;
    visibility: hidden;
    background-image: var(--painting);
    background-size: 100% 100%;
    background-clip: text;
    color: transparent;
    /* Caravaggio's ground is near black: lift the paint so the lit figure reads, without the
       glare that would compete with the text in front of it. */
    filter: brightness(1.5) saturate(1.25);
    /* Light where the lamp is, plus the flood that a click sends across the figure. */
    mask-image:
      radial-gradient(circle var(--lamp) at var(--x) var(--y), black 35%, transparent),
      radial-gradient(
        circle at var(--x) var(--y),
        black var(--flood),
        transparent calc(var(--flood) + 12%)
      );
  }

  .ascii-canvas[data-lamp] .ascii-paint,
  .ascii-canvas[data-lit] .ascii-paint {
    visibility: visible;
  }

  .ascii-canvas[data-lit] {
    --flood: 150%;
  }

  .ascii-canvas[data-lamp] {
    --lamp: 11rem;
  }

  /* On the light ground the paint needs depth, not light: brightened, it fades into the page.
     Darkened, its colours read as dark as the unlit ink does. */
  :global(:root[data-theme='light']) .ascii-paint {
    filter: brightness(0.6) contrast(1.35) saturate(1.3);
  }

  @media (prefers-reduced-motion: reduce) {
    .ascii-canvas {
      transition: none;
    }
  }
</style>

<script>
  // Lamp follows a fine pointer; the switch (or a click on the figure) floods the real colours.
  // When the art is a backdrop, the lamp follows the pointer over the whole stage around it.
  for (const figure of document.querySelectorAll<HTMLElement>('[data-ascii]')) {
    const canvas = figure.querySelector<HTMLElement>('.ascii-canvas');
    const button = figure.querySelector<HTMLButtonElement>('.ascii-switch');
    const label = button?.querySelector('.ascii-switch-label');
    if (!canvas || !button || !label) continue;
    const stage = figure.closest<HTMLElement>('[data-ascii-stage]') ?? canvas;
    const ink = canvas.querySelector('.ascii-ink');
    const paint = canvas.querySelector('.ascii-paint');
    // The colour layer (its text and its image) loads the first time it is needed.
    const fillPaint = (): void => {
      if (!ink || !paint || paint.textContent) return;
      paint.textContent = ink.textContent;
      canvas.style.setProperty('--painting', `url('${canvas.dataset['painting'] ?? ''}')`);
    };

    const aim = (event: PointerEvent): void => {
      const box = canvas.getBoundingClientRect();
      canvas.style.setProperty('--x', `${String(((event.clientX - box.left) / box.width) * 100)}%`);
      canvas.style.setProperty('--y', `${String(((event.clientY - box.top) / box.height) * 100)}%`);
    };

    const setLit = (lit: boolean): void => {
      fillPaint();
      canvas.toggleAttribute('data-lit', lit);
      button.setAttribute('aria-pressed', String(lit));
      label.textContent = (lit ? button.dataset['off'] : button.dataset['on']) ?? '';
    };

    if (window.matchMedia('(pointer: fine)').matches) {
      stage.addEventListener('pointerenter', () => {
        fillPaint();
        canvas.toggleAttribute('data-lamp', true);
      });
      stage.addEventListener('pointerleave', () => canvas.toggleAttribute('data-lamp', false));
      stage.addEventListener('pointermove', aim);
    }
    canvas.addEventListener('click', (event) => {
      aim(event);
      setLit(!canvas.hasAttribute('data-lit'));
    });
    button.addEventListener('click', () => setLit(!canvas.hasAttribute('data-lit')));
  }
</script>
