---
import { getImage } from 'astro:assets';

import painting from '../../assets/art/narcissus.jpg';
import art from '../../assets/art/narcissus.txt?raw';
import type { Locale } from '../../domain/shared/locale';
import { formatNumber } from '../i18n/format';

/**
 * Caravaggio's Narcissus as text (generated by scripts/generate-ascii.mjs). Two copies of the
 * same characters are stacked: one in the ochre ink, and one filled with the painting itself
 * (background-clip: text) that a lamp reveals around the pointer and a click floods across the
 * whole figure. The effect is the reference's WebGL shader rebuilt with text and CSS: no
 * canvas, no library, about 1 kB of script (ADR 0018).
 */
interface Props {
  locale: Locale;
  alt: string;
  caption: string;
  characters: string;
  lightOn: string;
  lightOff: string;
  class?: string;
}

const { locale, alt, caption, characters, lightOn, lightOff, class: className } = Astro.props;

const text = art.replace(/\n+$/, '');
const count = text.replace(/\s/g, '').length;
const lines = text.split('\n');
const columns = lines[0]?.length ?? 120;
// Width over height of the drawing: cells are 0.6 wide for each 1 of height.
const ratio = (columns * 0.6) / lines.length;
// The colour layer only needs one pixel per character, so a tiny copy of the painting is enough.
const colour = await getImage({ src: painting, width: columns * 2, format: 'webp' });
const countLabel = characters.replace('{count}', formatNumber(locale, count));
---

<figure class:list={['ascii-art', className]} style={`--ratio: ${ratio.toFixed(4)}`} data-ascii>
  <div
    class="ascii-canvas"
    role="img"
    aria-label={alt}
    style={`--columns: ${String(columns)}; --painting: url('${colour.src}')`}
  >
    <pre class="ascii-layer ascii-ink" aria-hidden="true">{text}</pre>
    <pre class="ascii-layer ascii-paint" aria-hidden="true">{text}</pre>
  </div>
  <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 font-mono text-eyebrow text-subtle">
    <span>
      {caption} · {countLabel}
    </span>
    <button
      type="button"
      class="ascii-switch inline-flex min-h-11 items-center gap-2 rounded-chip text-muted transition-colors duration-150 hover:text-ink"
      aria-pressed="false"
      data-on={lightOn}
      data-off={lightOff}
    >
      <span class="ascii-bulb size-2 rounded-chip bg-line-strong" aria-hidden="true"></span>
      <span class="ascii-switch-label">{lightOn}</span>
    </button>
  </figcaption>
</figure>

<style>
  /* Registered so the lamp radius and the flood can transition smoothly. */
  @property --lamp {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  @property --flood {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 0%;
  }

  @property --dawn {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 160%;
  }

  .ascii-art {
    container-type: inline-size;
  }

  /* Beside the text, as large as the column allows while the whole figure and its caption stay
     within one screen. */
  @media (min-width: 64rem) {
    .ascii-art {
      width: min(100%, calc((100svh - 13rem) * var(--ratio)));
    }
  }

  .ascii-canvas {
    --x: 38%;
    --y: 40%;
    position: relative;
    transition:
      --lamp 400ms var(--ease-out),
      --flood 1400ms var(--ease-out);
  }

  .ascii-layer {
    margin: 0;
    /* Geist Mono advances 0.6em per character: this fits every column in the figure's width. */
    font-family: var(--font-mono);
    /* The glyph ramp was measured at this weight (scripts/generate-ascii.mjs). */
    font-weight: 600;
    font-size: calc(100cqi / (var(--columns) * 0.6));
    line-height: 1;
    letter-spacing: 0;
    white-space: pre;
    user-select: none;
  }

  /* The ink steps aside wherever the painting shows through: under the lamp, and everywhere
     once the light is on. */
  .ascii-ink {
    color: var(--color-ascii);
    mask-image: radial-gradient(circle var(--lamp) at var(--x) var(--y), transparent 35%, black);
    transition: opacity 1200ms var(--ease-out);
  }

  .ascii-canvas[data-lit] .ascii-ink {
    opacity: 0;
  }

  .ascii-paint {
    position: absolute;
    inset: 0;
    background-image: var(--painting);
    background-size: 100% 100%;
    background-clip: text;
    color: transparent;
    /* Caravaggio's ground is near black: lift the paint so the lit figure reads on the page. */
    filter: brightness(2.5) saturate(1.2);
    /* Light where the lamp is, plus the flood that a click sends across the figure. */
    mask-image:
      radial-gradient(circle var(--lamp) at var(--x) var(--y), black 35%, transparent),
      radial-gradient(
        circle at var(--x) var(--y),
        black var(--flood),
        transparent calc(var(--flood) + 12%)
      );
  }

  .ascii-canvas[data-lit] {
    --flood: 150%;
  }

  .ascii-canvas[data-lamp] {
    --lamp: 11rem;
  }

  /* A lamp held close burns brighter than the room light. */
  .ascii-canvas[data-lamp]:not([data-lit]) .ascii-paint {
    filter: brightness(3) saturate(1.2);
  }

  /* On the light ground the paint needs depth, not light: brightened, it fades into the page. */
  :global(:root[data-theme='light']) .ascii-paint,
  :global(:root[data-theme='light']) .ascii-canvas[data-lamp]:not([data-lit]) .ascii-paint {
    filter: brightness(0.85) contrast(1.25) saturate(1.4);
  }

  .ascii-canvas[data-lit] + figcaption .ascii-bulb {
    background-color: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent);
  }

  /* First paint: the ink develops outward from the head, like a figure leaving the dark. */
  @media (prefers-reduced-motion: no-preference) {
    .ascii-ink {
      mask-image:
        radial-gradient(circle var(--lamp) at var(--x) var(--y), transparent 35%, black),
        radial-gradient(circle at 30% 30%, black var(--dawn), transparent calc(var(--dawn) + 20%));
      mask-composite: intersect;
      animation: dawn 2.4s var(--ease-out) 150ms both;
    }
  }

  @keyframes dawn {
    from {
      --dawn: 0%;
    }

    to {
      --dawn: 160%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ascii-canvas {
      transition: none;
    }
  }
</style>

<script>
  // Lamp follows a fine pointer; the switch (or a click on the figure) floods the real colours.
  for (const figure of document.querySelectorAll<HTMLElement>('[data-ascii]')) {
    const canvas = figure.querySelector<HTMLElement>('.ascii-canvas');
    const button = figure.querySelector<HTMLButtonElement>('.ascii-switch');
    const label = button?.querySelector('.ascii-switch-label');
    if (!canvas || !button || !label) continue;

    const aim = (event: PointerEvent): void => {
      const box = canvas.getBoundingClientRect();
      canvas.style.setProperty('--x', `${String(((event.clientX - box.left) / box.width) * 100)}%`);
      canvas.style.setProperty('--y', `${String(((event.clientY - box.top) / box.height) * 100)}%`);
    };

    const setLit = (lit: boolean): void => {
      canvas.toggleAttribute('data-lit', lit);
      button.setAttribute('aria-pressed', String(lit));
      label.textContent = (lit ? button.dataset['off'] : button.dataset['on']) ?? '';
    };

    if (window.matchMedia('(pointer: fine)').matches) {
      canvas.addEventListener('pointerenter', () => canvas.toggleAttribute('data-lamp', true));
      canvas.addEventListener('pointerleave', () => canvas.toggleAttribute('data-lamp', false));
      canvas.addEventListener('pointermove', aim);
    }
    canvas.addEventListener('click', (event) => {
      aim(event);
      setLit(!canvas.hasAttribute('data-lit'));
    });
    button.addEventListener('click', () => setLit(!canvas.hasAttribute('data-lit')));
  }
</script>
