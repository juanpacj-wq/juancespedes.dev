---
import { getImage } from 'astro:assets';

import type { Project } from '../../domain/project/project';
import type { Dictionary } from '../i18n/dictionary';
import { formatYears } from '../i18n/format';
import { projectPath } from '../i18n/routes';
import { mediaFor } from './media';
import ScreenPlaceholder from './ScreenPlaceholder.astro';
import { SCREENSHOT_QUALITY } from './screenshots';

/**
 * A project in the grid under the stage: its screen, its name, its kind and years. The summary
 * and the figures live on the project page, one click away (ADR 0029). The title link stretches
 * over the whole card, so there is one link per project and its name is the title.
 *
 * The screenshot is decoration (hidden from assistive technology) and keeps its address in data
 * attributes until the grid comes near: a lazy image within the browser's look-ahead distance
 * still downloads with the page (CLAUDE.md, the performance budget).
 */
interface Props {
  t: Dictionary;
  project: Project;
}

const { t, project } = Astro.props;
const href = projectPath(project.locale, project.slug);
const media = mediaFor(project.slug);
const sizes = '(min-width: 1024px) 31vw, (min-width: 768px) 46vw, 92vw';
const shot = media.card
  ? await getImage({
      src: media.card.src,
      widths: [480, 800, 1200, 1600],
      sizes,
      quality: SCREENSHOT_QUALITY.webp,
    })
  : null;
---

<article id={`project-${project.slug}`} class="project-card group relative flex flex-col gap-4">
  <div
    class="project-card-shot aspect-16/10 overflow-hidden rounded-panel bg-surface shadow-bevel"
    aria-hidden="true"
  >
    <div
      class="size-full transition-transform duration-700 ease-out motion-safe:group-hover:scale-[1.02]"
      style={`view-transition-name: project-screen-${project.slug}`}
    >
      {shot ? (
        <img
          data-card-shot
          data-src={shot.src}
          data-srcset={shot.srcSet.attribute}
          sizes={sizes}
          width={shot.attributes.width}
          height={shot.attributes.height}
          alt=""
          decoding="async"
          class="size-full object-cover object-top-left"
        />
      ) : (
        <ScreenPlaceholder slug={project.slug} compact />
      )}
    </div>
  </div>
  <div class="flex flex-col gap-1">
    <h3 class="text-lead font-medium text-balance text-ink">
      <a href={href} class="project-card-link after:absolute after:inset-0 after:z-20">
        {project.title}
      </a>
    </h3>
    <p class="font-mono text-eyebrow tracking-widest text-subtle uppercase">
      {t.kindLabels[project.kind]} · {formatYears(project.period, t)}
    </p>
  </div>
</article>

<script>
  import cardStyles from '../styles/cards.css?url';

  /*
   * The screenshots, and the styles of the placeholder drawn when one is missing, load when the
   * grid comes within a screen of the viewport. It sits below the first screen, so they never
   * compete with the first paint; a visit that lands on it loads them at once.
   */
  const load = () => {
    const sheet = document.createElement('link');
    sheet.rel = 'stylesheet';
    sheet.href = cardStyles;
    document.head.append(sheet);
    for (const shot of document.querySelectorAll<HTMLImageElement>('img[data-card-shot]')) {
      shot.srcset = shot.dataset.srcset ?? '';
      shot.src = shot.dataset.src ?? '';
    }
  };
  const firstCard = document.querySelector('.project-card');
  if (firstCard && 'IntersectionObserver' in window) {
    const watch = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        watch.disconnect();
        load();
      },
      { rootMargin: '100% 0px' },
    );
    watch.observe(firstCard);
  } else {
    load();
  }
</script>
