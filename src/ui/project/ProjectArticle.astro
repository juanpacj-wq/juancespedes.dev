---
import { getImage } from 'astro:assets';

import type { Project } from '../../domain/project/project';
import type { Dictionary } from '../i18n/dictionary';
import { formatPeriod, formatYears } from '../i18n/format';
import { homeSectionPath, projectPath, projectsListPath } from '../i18n/routes';
import Icon from '../icons/Icon.astro';
import Button from '../primitives/Button.astro';
import Container from '../primitives/Container.astro';
import TextLink from '../primitives/TextLink.astro';
import ArchitectureDiagram from './ArchitectureDiagram.astro';
import DetailSection from './DetailSection.astro';
import { captionFor, mediaFor } from './media';
import ProjectGallery from './ProjectGallery.astro';
import ProjectScreens from './ProjectScreens.astro';
import ScreenPlaceholder from './ScreenPlaceholder.astro';
import { SCREENSHOT_QUALITY, SCREENSHOT_WIDTHS } from './screenshots';
import TechBand from './TechBand.astro';
import chapterStyles from '../styles/case-study.css?url';
import placeholderStyles from '../styles/screen-placeholder.css?url';
import '../styles/case-study-hero.css';

/**
 * A project page, told as a case study (ADR 0011, redesigned in ADR 0021): a hero with the
 * product on a stage, the problem in plain words with what changed for the people involved,
 * then the engineering chapters (role, constraints, decisions, architecture, results, hindsight)
 * and a way to the next case. Every block comes from validated content, so a missing section is
 * a content error, not a layout one.
 *
 * The page reads complete without JavaScript or motion. The motion layer is progressive: CSS
 * scroll-driven animations where the browser supports them, and one small script
 * (case-study-motion.ts) for the chapter nav, the counting figures and the diagram wires.
 */
interface Props {
  t: Dictionary;
  project: Project;
  previous: Project | null;
  next: Project | null;
}

const { t, project, previous, next } = Astro.props;
const { locale } = project;
const two = (n: number) => String(n + 1).padStart(2, '0');
const media = mediaFor(project.slug);
// A stock photo says nothing about the product; the drawn screen at least matches the home card.
const cover = media.cover && !media.cover.stock ? media.cover : null;
// The cover is the first screen's largest paint and holds small type: it gets the gallery's
// widths and quality (screenshots.ts), not the encoders' defaults, which smear text.
const coverSizes = '(min-width: 1280px) 1100px, 90vw';
const [coverAvif, coverWebp] = cover
  ? await Promise.all(
      (['avif', 'webp'] as const).map((format) =>
        getImage({
          src: cover.src,
          widths: [...SCREENSHOT_WIDTHS.wide],
          sizes: coverSizes,
          format,
          quality: SCREENSHOT_QUALITY[format],
        }),
      ),
    )
  : [null, null];
const nextMedia = next ? mediaFor(next.slug) : null;
// The next case's screen sits at the end of the page: decoration that waits for the chapters to
// start (case-study-motion.ts); without JavaScript the card keeps its stage, without the picture.
const nextSizes = '(min-width: 1024px) 40vw, 90vw';
const nextCard = nextMedia?.card ?? null;
const nextShot = nextCard
  ? await Promise.all(
      (['avif', 'webp'] as const).map((format) =>
        getImage({
          src: nextCard.src,
          widths: [480, 800, 1200],
          sizes: nextSizes,
          format,
          quality: SCREENSHOT_QUALITY[format],
        }),
      ),
    )
  : null;
// Same rule for the gallery: only real images; stock stand-ins wait in the folder for their swap.
const gallery = media.gallery.filter((image) => !image.stock);
const mobile = media.mobile.filter((image) => !image.stock);
const solution = gallery.length > 0 || mobile.length > 0;
const words = (text: string) => text.split(/\s+/).filter(Boolean);

const kindChapters: Record<Project['kind'], [string, string][]> = {
  'case-study': [
    ['overview', t.project.overview],
    ['problem', t.project.problem],
    ...(solution ? ([['solution', t.project.solution]] as [string, string][]) : []),
    ['role', t.project.responsibilities],
    ['constraints', t.project.constraints],
    ['decisions', t.project.decisions],
    ['architecture', t.project.architecture],
    ['results', t.project.results],
    ['lessons', t.project.lessons],
  ],
  report: [['report', t.project.businessQuestions]],
  'open-source': [['repository', t.project.repository]],
  tool: [['tool', t.project.automates]],
};
const galleryChapter: [string, string][] =
  project.kind !== 'case-study' && solution ? [['solution', t.project.solution]] : [];
const chapters = [
  ...kindChapters[project.kind],
  ...galleryChapter,
  ['stack', t.project.stack],
] as const;
// The address in the browser frame: the public site when there is one, otherwise a neutral path.
const address = project.links[0] ? new URL(project.links[0].url).host : `/${project.slug}`;
const numberOf = (id: string) => two(chapters.findIndex(([chapter]) => chapter === id));
const titleOf = (id: string) => chapters.find(([chapter]) => chapter === id)?.[1] ?? id;
const hookWords = project.kind === 'case-study' ? words(project.story.hook) : [];
---

<div class="cs-progress" aria-hidden="true"></div>

<article class="cs-article" data-chapter-styles={chapterStyles}>
  <header data-cs-hero class="relative flex flex-col gap-12 pb-16 sm:gap-16 sm:pb-24">
    <Container class="flex flex-col gap-8 pt-10 sm:pt-16">
      <a
        href={projectsListPath(locale)}
        class="group inline-flex w-fit items-center gap-2 text-small text-muted transition-colors hover:text-ink"
      >
        <Icon
          name="arrow-right"
          size={16}
          class="rotate-180 transition-transform duration-500 ease-out group-hover:-translate-x-1"
        />
        {t.project.back}
      </a>

      <p class="font-mono text-eyebrow tracking-widest text-subtle uppercase">
        {t.kindLabels[project.kind]} · {formatYears(project.period, t)}
        {project.confidentiality === 'anonymized' && <> · {t.projects.anonymized}</>}
      </p>

      <h1 class="cs-title max-w-6xl font-display text-display font-light text-balance text-ink">
        {words(project.title).map((word, index) => (
          <>
            <span class="cs-word" style={`--i:${String(index)}`}>
              {word}
            </span>{' '}
          </>
        ))}
      </h1>

      <div class="grid items-end gap-8 lg:grid-cols-12">
        <p class="cs-fade text-lead text-pretty text-muted lg:col-span-7">{project.summary}</p>
        <div class="cs-fade flex flex-col gap-3 lg:col-span-5 lg:items-end">
          <p class="font-mono text-eyebrow tracking-widest text-subtle uppercase">
            {t.project.howIHelped}
          </p>
          <ul class="flex flex-wrap gap-2 lg:justify-end">
            {project.capabilities.map((capability) => (
              <li class="rounded-chip bg-surface-raised px-4 py-2 text-small text-ink shadow-bevel">
                {t.capabilityLabels[capability]}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </Container>

    <Container>
      <figure class="flex flex-col gap-3">
        <div class="cs-stage" data-tone={project.order % 2 === 0 ? 'success' : 'accent'}>
          <div class="cs-stage-rise">
            <div
              class="cs-stage-screen"
              style={`view-transition-name: project-screen-${project.slug}`}
            >
              {cover ? (
                <picture>
                  <source
                    type="image/avif"
                    srcset={coverAvif?.srcSet.attribute}
                    sizes={coverSizes}
                  />
                  <img
                    src={coverWebp?.src}
                    srcset={coverWebp?.srcSet.attribute}
                    sizes={coverSizes}
                    width={cover.src.width}
                    height={cover.src.height}
                    alt={captionFor(project.slug, 'cover', locale) ?? ''}
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                    class="size-full rounded-card object-cover object-top-left"
                  />
                </picture>
              ) : (
                <>
                  {/* The drawn screen is on the first screen: its styles come with it. */}
                  <link rel="stylesheet" href={placeholderStyles} />
                  <ScreenPlaceholder slug={project.slug} />
                </>
              )}
            </div>
          </div>
          {project.metrics.slice(0, 2).map((metric, index) => (
            <p
              class:list={['cs-badge', index === 0 ? 'cs-badge--one' : 'cs-badge--two']}
              aria-hidden="true"
            >
              <span class="text-title font-light tracking-tight text-ink">{metric.value}</span>
              <span class="line-clamp-2 text-small text-muted">{metric.label}</span>
            </p>
          ))}
        </div>
      </figure>
    </Container>

    <Container>
      <section aria-labelledby="facts-title">
        <h2 id="facts-title" class="sr-only">
          {t.project.facts}
        </h2>
        <dl class="grid gap-x-8 gap-y-6 border-y border-line py-8 sm:grid-cols-2 lg:grid-cols-4">
          <div class="flex flex-col gap-2">
            <dt class="font-mono text-eyebrow tracking-widest text-subtle uppercase">
              {t.project.role}
            </dt>
            <dd class="text-pretty text-ink">{project.role}</dd>
          </div>
          <div class="flex flex-col gap-2">
            <dt class="font-mono text-eyebrow tracking-widest text-subtle uppercase">
              {t.project.period}
            </dt>
            <dd class="text-ink">{formatPeriod(locale, project.period, t)}</dd>
          </div>
          <div class="flex flex-col gap-2">
            <dt class="font-mono text-eyebrow tracking-widest text-subtle uppercase">
              {t.project.stack}
            </dt>
            <dd class="text-pretty text-ink">{project.stack.slice(0, 5).join(' · ')}</dd>
          </div>
          <div class="flex flex-col gap-2">
            <dt class="font-mono text-eyebrow tracking-widest text-subtle uppercase">
              {t.project.links}
            </dt>
            <dd class="flex flex-col gap-1">
              {project.links.length > 0
                ? project.links.map((link) => (
                    <TextLink href={link.url} external externalLabel={t.a11y.external}>
                      {link.label}
                    </TextLink>
                  ))
                : project.kind === 'open-source' && (
                    <TextLink href={project.repository} external externalLabel={t.a11y.external}>
                      {t.project.repository}
                    </TextLink>
                  )}
              {project.confidentiality === 'anonymized' && (
                <span class="text-small text-pretty text-muted">{t.project.anonymizedNote}</span>
              )}
            </dd>
          </div>
        </dl>
      </section>
    </Container>
  </header>

  <Container class="flex flex-col gap-24 pb-24 sm:gap-32 sm:pb-32">
    {project.kind === 'case-study' && (
      <>
        <DetailSection
          id="overview"
          title={titleOf('overview')}
          number={numberOf('overview')}
          wide
          quiet
        >
          <p class="cs-hook max-w-5xl font-display text-heading font-light text-balance">
            {hookWords.map((word, index) => (
              <>
                <span
                  class="cs-w"
                  style={`--p:${(index / Math.max(hookWords.length - 1, 1)).toFixed(3)}`}
                >
                  {word}
                </span>{' '}
              </>
            ))}
          </p>
          {project.metrics.length > 0 && (
            <ul
              class="mt-14 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
              aria-label={t.project.results}
            >
              {project.metrics.map((metric, index) => (
                <li
                  class:list={[
                    'cs-stat reveal',
                    // One figure gets the whole row, laid out sideways; an odd one out leads.
                    project.metrics.length === 1
                      ? 'cs-stat--solo sm:col-span-2 lg:col-span-3'
                      : project.metrics.length % 2 === 1 &&
                        index === 0 &&
                        'sm:col-span-2 lg:col-span-1',
                  ]}
                  data-glow
                >
                  <p
                    class="cs-figure text-heading font-extralight text-balance tabular-nums text-ink"
                    data-count={metric.value}
                  >
                    {metric.value}
                  </p>
                  <p class="text-pretty text-muted">{metric.label}</p>
                  <p class="mt-auto border-t border-line pt-4 font-mono text-eyebrow text-pretty text-subtle">
                    {t.metric.source}: {metric.source}
                  </p>
                </li>
              ))}
            </ul>
          )}
        </DetailSection>

        <DetailSection id="problem" title={titleOf('problem')} number={numberOf('problem')}>
          <p class="text-lead text-pretty text-muted">{project.problem}</p>
          <ol class="cs-shifts mt-12 flex flex-col gap-3">
            <li class="hidden grid-cols-[1fr_2.5rem_1fr] gap-3 px-1 sm:grid" aria-hidden="true">
              <span class="flex items-center gap-2 font-mono text-eyebrow tracking-widest text-subtle uppercase">
                <Icon name="close" size={14} />
                {t.project.before}
              </span>
              <span />
              <span class="flex items-center gap-2 font-mono text-eyebrow tracking-widest text-success uppercase">
                <Icon name="check" size={14} />
                {t.project.after}
              </span>
            </li>
            {project.story.shifts.map((shift) => (
              <li class="cs-shift reveal grid items-stretch gap-3 sm:grid-cols-[1fr_2.5rem_1fr]">
                <p class="cs-before">
                  <span class="font-mono text-eyebrow tracking-widest text-subtle uppercase sm:sr-only">
                    {t.project.before}
                    <span class="sr-only">:</span>
                  </span>
                  {shift.before}
                </p>
                <span class="cs-shift-arrow" aria-hidden="true">
                  <Icon name="arrow-right" size={16} />
                </span>
                <p class="cs-after">
                  <span class="font-mono text-eyebrow tracking-widest text-success uppercase sm:sr-only">
                    {t.project.after}
                    <span class="sr-only">:</span>
                  </span>
                  {shift.after}
                </p>
              </li>
            ))}
          </ol>
        </DetailSection>

        {solution && (
          <DetailSection
            id="solution"
            title={titleOf('solution')}
            number={numberOf('solution')}
            wide
          >
            {gallery.length > 0 && (
              <ProjectGallery
                t={t}
                slug={project.slug}
                locale={locale}
                images={gallery}
                address={address}
              />
            )}
            {mobile.length > 0 && (
              <ProjectScreens t={t} slug={project.slug} locale={locale} images={mobile} />
            )}
          </DetailSection>
        )}

        <DetailSection id="role" title={titleOf('role')} number={numberOf('role')}>
          <p class="font-display text-quote font-light text-pretty text-ink">{project.role}</p>
          {project.responsibilities.length > 0 && (
            <ol class="cs-rail mt-12 flex flex-col gap-10">
              {project.responsibilities.map((item, index) => (
                <li class="relative flex gap-6 reveal">
                  <span class="cs-rail-dot" aria-hidden="true">
                    {two(index)}
                  </span>
                  <p class="pt-1.5 text-pretty text-muted">{item}</p>
                </li>
              ))}
            </ol>
          )}
        </DetailSection>

        <DetailSection
          id="constraints"
          title={titleOf('constraints')}
          number={numberOf('constraints')}
        >
          <ul class="grid gap-4 sm:grid-cols-2">
            {project.constraints.map((item, index) => (
              <li class="cs-tile reveal" data-glow>
                <span class="font-mono text-eyebrow text-accent-ink" aria-hidden="true">
                  R{String(index + 1)}
                </span>
                <p class="text-pretty text-ink">{item}</p>
              </li>
            ))}
          </ul>
        </DetailSection>

        <DetailSection
          id="decisions"
          title={titleOf('decisions')}
          number={numberOf('decisions')}
          wide
        >
          <ol class="cs-decisions flex flex-col gap-6">
            {project.decisions.map((decision, index) => (
              <li class="cs-decision" style={`--i:${String(index)}`}>
                <div class="flex flex-col gap-4 lg:col-span-5">
                  <span
                    class="font-display text-display leading-none font-light text-accent-ink"
                    aria-hidden="true"
                  >
                    {two(index)}
                  </span>
                  <h3 class="font-display text-title font-light text-balance text-ink sm:text-quote">
                    {decision.title}
                  </h3>
                </div>
                <div class="flex flex-col gap-6 lg:col-span-7">
                  <p class="text-lead text-pretty text-muted">{decision.rationale}</p>
                  {decision.alternatives.length > 0 && (
                    <div class="cs-choice">
                      <p class="flex items-center gap-2 font-mono text-eyebrow tracking-widest text-subtle uppercase">
                        <Icon name="close" size={14} />
                        {t.project.discarded}
                      </p>
                      <ul class="flex flex-col gap-1">
                        {decision.alternatives.map((alternative) => (
                          <li class="text-pretty text-muted">{alternative}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </DetailSection>

        <DetailSection
          id="architecture"
          title={titleOf('architecture')}
          number={numberOf('architecture')}
          wide
        >
          <ArchitectureDiagram t={t} architecture={project.architecture} />
        </DetailSection>

        <DetailSection id="results" title={titleOf('results')} number={numberOf('results')}>
          <ul class="flex flex-col">
            {project.outcomes.map((item) => (
              <li class="cs-outcome reveal">
                <span class="cs-outcome-check" aria-hidden="true">
                  <Icon name="check" size={16} />
                </span>
                <p class="text-lead text-pretty text-ink">{item}</p>
              </li>
            ))}
          </ul>
        </DetailSection>

        <DetailSection id="lessons" title={titleOf('lessons')} number={numberOf('lessons')}>
          <ul class="flex flex-col gap-12">
            {project.lessons.map((item) => (
              <li class="cs-lesson reveal">
                <p class="font-display text-quote font-light text-pretty text-ink">{item}</p>
              </li>
            ))}
          </ul>
        </DetailSection>
      </>
    )}

    {project.kind === 'report' && (
      <DetailSection id="report" title={titleOf('report')} number={numberOf('report')}>
        <ul class="mb-8 flex flex-col gap-3 text-muted">
          {project.businessQuestions.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <dl class="grid gap-6 sm:grid-cols-2">
          <div>
            <dt class="mb-2 font-mono text-eyebrow tracking-widest text-subtle uppercase">
              {t.project.dataSources}
            </dt>
            {project.dataSources.map((item) => (
              <dd class="text-muted">{item}</dd>
            ))}
          </div>
          <div>
            <dt class="mb-2 font-mono text-eyebrow tracking-widest text-subtle uppercase">
              {t.project.tool}
            </dt>
            <dd class="text-muted">{project.tool}</dd>
          </div>
          {project.highlightedMeasures.length > 0 && (
            <div>
              <dt class="mb-2 font-mono text-eyebrow tracking-widest text-subtle uppercase">
                {t.project.highlightedMeasures}
              </dt>
              {project.highlightedMeasures.map((item) => (
                <dd class="text-muted">{item}</dd>
              ))}
            </div>
          )}
        </dl>
      </DetailSection>
    )}

    {project.kind === 'open-source' && (
      <DetailSection id="repository" title={titleOf('repository')} number={numberOf('repository')}>
        <dl class="grid gap-6 sm:grid-cols-2">
          <div>
            <dt class="mb-2 font-mono text-eyebrow tracking-widest text-subtle uppercase">
              {t.project.repository}
            </dt>
            <dd>
              <TextLink href={project.repository} external externalLabel={t.a11y.external}>
                {project.repository.replace('https://', '')}
              </TextLink>
            </dd>
          </div>
          <div>
            <dt class="mb-2 font-mono text-eyebrow tracking-widest text-subtle uppercase">
              {t.project.license}
            </dt>
            <dd class="text-muted">{project.license}</dd>
          </div>
          {project.install && (
            <div class="sm:col-span-2">
              <dt class="mb-2 font-mono text-eyebrow tracking-widest text-subtle uppercase">
                {t.project.install}
              </dt>
              <dd>
                <code class="block overflow-x-auto rounded-control bg-surface-raised px-4 py-3 font-mono text-small text-ink">
                  {project.install}
                </code>
              </dd>
            </div>
          )}
        </dl>
      </DetailSection>
    )}

    {project.kind === 'tool' && (
      <DetailSection id="tool" title={titleOf('tool')} number={numberOf('tool')}>
        <p class="mb-6 text-lead text-muted">{project.automates}</p>
        <p class="font-mono text-small text-subtle">
          {t.project.platform}: {project.platform}
        </p>
      </DetailSection>
    )}

    {project.kind !== 'case-study' && solution && (
      <DetailSection id="solution" title={titleOf('solution')} number={numberOf('solution')} wide>
        {gallery.length > 0 && (
          <ProjectGallery
            t={t}
            slug={project.slug}
            locale={locale}
            images={gallery}
            address={address}
          />
        )}
        {mobile.length > 0 && (
          <ProjectScreens t={t} slug={project.slug} locale={locale} images={mobile} />
        )}
      </DetailSection>
    )}

    <DetailSection id="stack" title={titleOf('stack')} number={numberOf('stack')} wide>
      <div class="cs-bleed">
        <TechBand label={t.project.stack} stack={project.stack} />
      </div>
    </DetailSection>
  </Container>

  <Container class="flex flex-col gap-6 pt-24 pb-24 sm:pt-32">
    <aside class="cs-cta" aria-labelledby="cs-cta-title">
      <h2
        id="cs-cta-title"
        class="max-w-3xl font-display text-heading font-light text-balance text-ink"
      >
        {t.project.ctaTitle}
      </h2>
      <p class="max-w-xl text-lead text-pretty text-muted">{t.project.ctaBody}</p>
      <div class="flex flex-wrap gap-3">
        <Button href={homeSectionPath(locale, 'contact')} size="lg" icon="arrow-right">
          {t.project.ctaContact}
        </Button>
      </div>
    </aside>

    {(previous ?? next) && (
      <nav aria-label={t.project.more} class="flex flex-col gap-4">
        {next && (
          <a href={projectPath(locale, next.slug)} class="cs-next group">
            <span class="relative z-10 flex flex-col gap-5 p-6 sm:p-10 lg:w-[58%] lg:p-12">
              <span class="font-mono text-eyebrow tracking-widest text-accent-ink uppercase">
                {t.project.nextCase}
              </span>
              <span class="font-display text-heading font-light text-balance text-ink">
                {next.title}
              </span>
              <span class="line-clamp-3 text-pretty text-muted">{next.summary}</span>
              <span class="cs-next-cta">
                {t.projects.viewCase}
                <Icon name="arrow-right" size={16} />
              </span>
            </span>
            <span class="cs-next-stage" aria-hidden="true">
              <span class="cs-next-screen">
                {nextShot ? (
                  <picture>
                    {nextShot.map((shot) => (
                      <source
                        type={`image/${shot.options.format ?? 'webp'}`}
                        data-srcset={shot.srcSet.attribute}
                        sizes={nextSizes}
                      />
                    ))}
                    <img
                      data-deferred
                      data-src={nextShot[1]?.src}
                      alt=""
                      width={nextCard?.src.width}
                      height={nextCard?.src.height}
                      decoding="async"
                      class="size-full rounded-card object-cover object-top-left"
                    />
                  </picture>
                ) : (
                  <ScreenPlaceholder slug={next.slug} />
                )}
              </span>
            </span>
          </a>
        )}
        {previous && (
          <a
            href={projectPath(locale, previous.slug)}
            class="group flex w-fit items-center gap-3 text-small text-muted transition-colors hover:text-ink"
          >
            <Icon
              name="arrow-right"
              size={16}
              class="rotate-180 transition-transform duration-500 ease-out group-hover:-translate-x-1"
            />
            <span>
              <span class="font-mono text-eyebrow tracking-widest uppercase">
                {t.project.previous}
              </span>
              <span class="mx-2 text-subtle" aria-hidden="true">
                ·
              </span>
              {previous.title}
            </span>
          </a>
        )}
      </nav>
    )}
  </Container>

  <nav class="cs-chapters" aria-label={t.project.chapters} data-chapters hidden>
    <ul class="cs-chapters-list">
      {chapters.map(([id, title]) => (
        <li>
          <a href={`#${id}`} class="cs-chapters-link" data-chapter-link={id}>
            {title}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <noscript>
    <link rel="stylesheet" href={chapterStyles} />
  </noscript>
</article>

<script>
  /*
   * Only the first screen's styles come with the HTML (case-study-hero.css, inlined). The
   * chapters below it get theirs once the page has loaded, or as soon as the reader scrolls,
   * taps or types, whichever comes first: nothing below the first screen competes with the first
   * paint (CLAUDE.md, the performance budget). The motion (its code too), and with it the
   * gallery's screenshots, starts once the sheet applies, so nothing it shows appears unstyled.
   * The URL comes from the page, so it is the same sheet the noscript fallback links.
   */
  const startCaseStudy = () => {
    void import('./case-study-motion').then(({ startCaseStudy: start }) => {
      start();
    });
  };
  const article = document.querySelector<HTMLElement>('[data-chapter-styles]');
  const href = article?.dataset.chapterStyles;
  // Transitions come back once a frame has been drawn with the sheet (case-study-hero.css): the
  // first callback runs before that frame's styles, the second after them.
  const ready = () => {
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        if (article) article.dataset.chaptersReady = '';
        startCaseStudy();
      });
    });
  };
  const triggers = ['scroll', 'pointerdown', 'keydown'] as const;
  let started = false;
  const addChapterStyles = () => {
    if (started) return;
    started = true;
    removeEventListener('load', addChapterStyles);
    for (const type of triggers) removeEventListener(type, addChapterStyles);
    if (!href) {
      ready();
      return;
    }
    // The logo band is driven by the motion code (live), never a bare scrollable row: mark it
    // before its styles apply, or it would be a scroll region without focus for a few frames.
    for (const band of document.querySelectorAll('[data-band]')) {
      band.toggleAttribute('data-live', true);
    }
    const sheet = document.createElement('link');
    sheet.rel = 'stylesheet';
    sheet.href = href;
    sheet.addEventListener('load', ready, { once: true });
    sheet.addEventListener('error', ready, { once: true });
    document.head.append(sheet);
  };
  if (document.readyState === 'complete') {
    addChapterStyles();
  } else {
    addEventListener('load', addChapterStyles, { once: true });
    for (const type of triggers) addEventListener(type, addChapterStyles, { passive: true });
  }
</script>
