---
/**
 * A drawn app window that stands in for a project screenshot until the real one is dropped in
 * src/assets/projects/<slug>/card.* (see media.ts). Pure markup on design tokens: it costs no
 * request and looks the same in both themes. The bar heights come from the slug, so each project
 * gets its own chart. Decorative: the card around it carries the meaning.
 */
interface Props {
  slug: string;
  compact?: boolean;
}

const { slug, compact = false } = Astro.props;

// A small deterministic sequence from the slug (FNV-1a, then a linear congruential step).
let seed = [...slug].reduce(
  (hash, char) => Math.imul(hash ^ char.charCodeAt(0), 16777619),
  2166136261,
);
const next = () => {
  seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
  return seed / 2 ** 32;
};
const bars = Array.from({ length: compact ? 9 : 14 }, () => Math.round(28 + next() * 68));
const rows = Array.from({ length: compact ? 2 : 4 }, () => Math.round(40 + next() * 45));
---

<div class="screen-placeholder flex size-full flex-col overflow-hidden rounded-card border border-line-strong bg-surface">
  <div class="flex h-9 shrink-0 items-center gap-3 border-b border-line bg-frame px-4">
    <span class="flex gap-1.5">
      <span class="size-2.5 rounded-full bg-line-strong"></span>
      <span class="size-2.5 rounded-full bg-line-strong"></span>
      <span class="size-2.5 rounded-full bg-line-strong"></span>
    </span>
    <span class="truncate rounded-chip bg-surface-raised px-3 py-0.5 font-mono text-eyebrow text-subtle">
      /{slug}
    </span>
  </div>
  <div class="flex min-h-0 flex-1">
    {!compact && (
      <div class="hidden w-28 shrink-0 flex-col gap-3 border-r border-line p-4 sm:flex">
        <span class="h-2 w-14 rounded-chip bg-accent/70"></span>
        {[70, 55, 80, 50, 65].map((width) => (
          <span class="h-1.5 rounded-chip bg-line-strong" style={`width:${String(width)}%`}></span>
        ))}
      </div>
    )}
    <div class="flex min-w-0 flex-1 flex-col gap-4 p-4 sm:p-5">
      <div class="flex items-center justify-between gap-4">
        <span class="h-2.5 w-32 rounded-chip bg-line-strong"></span>
        <span class="h-5 w-16 rounded-chip bg-accent/25"></span>
      </div>
      <div class:list={['grid gap-3', compact ? 'grid-cols-2' : 'grid-cols-3']}>
        {Array.from({ length: compact ? 2 : 3 }, (_, index) => (
          <div class="flex flex-col gap-2 rounded-control border border-line bg-surface-raised p-3">
            <span class="h-1.5 w-1/2 rounded-chip bg-line-strong"></span>
            <span
              class:list={['h-3 w-3/4 rounded-chip', index === 0 ? 'bg-accent/80' : 'bg-ink/60']}
            ></span>
          </div>
        ))}
      </div>
      <div class="flex min-h-24 flex-1 items-end gap-1.5 rounded-control border border-line bg-surface-raised p-3">
        {bars.map((height, index) => (
          <span
            class:list={[
              'flex-1 rounded-t-xs',
              index === bars.length - 3 ? 'bg-accent' : 'bg-success/45',
            ]}
            style={`height:${String(height)}%`}
          ></span>
        ))}
      </div>
      <div class="flex flex-col gap-2">
        {rows.map((width) => (
          <div class="flex items-center gap-3">
            <span class="size-2 shrink-0 rounded-full bg-success/70"></span>
            <span
              class="h-1.5 rounded-chip bg-line-strong"
              style={`width:${String(width)}%`}
            ></span>
          </div>
        ))}
      </div>
    </div>
  </div>
</div>
