---
import type { Achievement } from '../../domain/project/achievement';
import type { Locale } from '../../domain/shared/locale';
import type { Dictionary } from '../i18n/dictionary';
import AchievementCard from '../impact/AchievementCard.astro';
import Section from '../primitives/Section.astro';

/**
 * Results told for the people who hire: one figure per achievement, the sentence behind it and
 * where it happened, each opening its case study (ADR 0025, trimmed by ADR 0029). Where the
 * owner works is said once, in the about section.
 */
interface Props {
  t: Dictionary;
  locale: Locale;
  achievements: readonly Achievement[];
}

const { t, locale, achievements } = Astro.props;
---

{achievements.length > 0 && (
  <Section id="impact" title={t.impact.title}>
    <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {achievements.map((achievement) => (
        <AchievementCard locale={locale} achievement={achievement} />
      ))}
    </ul>
  </Section>
)}
