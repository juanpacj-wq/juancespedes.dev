---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';

import type { Locale } from '../../domain/shared/locale';
import type { Dictionary } from '../i18n/dictionary';
import ContactForm from '../islands/ContactForm';
import Card from '../primitives/Card.astro';
import Section from '../primitives/Section.astro';
import TextLink from '../primitives/TextLink.astro';

interface Props {
  t: Dictionary;
  locale: Locale;
  email: string;
  privacyHref: string;
  githubUrl: string;
  linkedinUrl: string;
}

const { t, locale, email, privacyHref, githubUrl, linkedinUrl } = Astro.props;
---

<Section id="contact" title={t.contact.title}>
  <p slot="description">{t.contact.description}</p>
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
    <Card padding="lg" class="lg:col-span-8">
      <ContactForm
        client:visible
        locale={locale}
        endpoint="/api/contact"
        siteKey={PUBLIC_TURNSTILE_SITE_KEY}
        privacyHref={privacyHref}
        text={t.form}
      />
    </Card>
    <aside class="flex flex-col gap-2 lg:col-span-4 lg:col-start-9">
      <p class="font-mono text-eyebrow tracking-widest text-subtle uppercase">
        {t.contact.emailLabel}
      </p>
      <TextLink href={`mailto:${email}`} class="text-body break-words">
        {email}
      </TextLink>
      <ul class="mt-4 flex flex-col gap-2" aria-label={t.contact.elsewhere}>
        <li>
          <TextLink href={linkedinUrl} external externalLabel={t.a11y.external}>
            LinkedIn
          </TextLink>
        </li>
        <li>
          <TextLink href={githubUrl} external externalLabel={t.a11y.external}>
            GitHub
          </TextLink>
        </li>
      </ul>
    </aside>
  </div>
</Section>
