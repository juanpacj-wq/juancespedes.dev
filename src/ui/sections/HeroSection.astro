---
import monoFont from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';

import type { Locale } from '../../domain/shared/locale';
import AsciiArt from '../art/AsciiArt.astro';
import type { Dictionary } from '../i18n/dictionary';
import Badge from '../primitives/Badge.astro';
import Button from '../primitives/Button.astro';
import Container from '../primitives/Container.astro';

interface Props {
  t: Dictionary;
  locale: Locale;
}

const { t, locale } = Astro.props;
const { roles } = t.hero;
---

<!--
  Two layers: the painting fills the hero as a backdrop, the content stands centred in front of
  it, below Narcissus's face. The lamp follows the pointer anywhere on the stage
  (data-ascii-stage).
-->
<!--
  The backdrop text is the largest paint of the page and is drawn in Geist Mono, which the
  browser would only find after the stylesheet: fetch it with the HTML.
-->
<link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
<!-- The hero slides up under the sticky bar (its height plus its border), so the painting fills the screen. -->
<section class="hero relative isolate -mt-[calc(4rem+1px)] overflow-hidden" data-ascii-stage>
  <div class="hero-art">
    <AsciiArt
      locale={locale}
      alt={t.art.alt}
      caption={t.art.caption}
      characters={t.art.characters}
      lightOn={t.art.lightOn}
      lightOff={t.art.lightOff}
    />
  </div>
  <!-- A pool of shadow behind the text, so it reads over the brightest paint. -->
  <div class="hero-veil pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <Container class="hero-front relative flex min-h-svh flex-col items-center justify-center gap-6 pt-28 pb-24 text-center">
    <Badge tone="success" status>
      {t.availability.available}
    </Badge>
    <!--
      The headline is read once, whole, from the hidden copy. The visible one rotates the role
      (the reference's title ticker): a column of roles, each moved up by the same step, plus a
      copy of the first one at the end so the last step lands where it started.
    -->
    <h1 class="hero-title max-w-7xl font-display text-display font-medium" data-role-heading>
      <span class="sr-only">{t.hero.headlineText}</span>
      <span aria-hidden="true" class="block">
        <span class="block">{t.hero.greeting}</span>
        <span class="role-line">
          {t.hero.rolePrefix && (
            <span class="role-prefix" data-role-prefix>
              {t.hero.rolePrefix}
            </span>
          )}
          <span class="role-ticker text-accent-ink" data-role-ticker>
            {[...roles, roles[0]].map((role) => (
              <span class="role-ticker-item">{role}</span>
            ))}
          </span>
        </span>
      </span>
    </h1>
    <p class="max-w-2xl text-lead text-pretty text-muted">{t.hero.pitch}</p>
    <div class="hero-actions flex flex-wrap justify-center gap-3 pt-2">
      <Button href="#projects" icon="arrow-down" size="lg">
        {t.hero.primaryCta}
      </Button>
      <Button href="#contact" variant="secondary" icon="arrow-right" size="lg">
        {t.hero.secondaryCta}
      </Button>
    </div>
  </Container>
</section>

<script>
  /*
   * Rotates the role every few seconds, one full turn, then rests on the first role: moving text
   * that never stops would need a pause control (WCAG 2.2.2). Only a transform changes, so no
   * frame repaints the glyphs or moves anything around them. Without motion it never starts.
   */
  const HOLD_MS = 2600;
  const ticker = document.querySelector<HTMLElement>('[data-role-ticker]');
  const prefix = document.querySelector<HTMLElement>('[data-role-prefix]');
  const first = ticker?.firstElementChild;

  /*
   * The ticker is as wide as the longest role and each role is centred in it, so a short role
   * leaves a gap between it and the prefix ("ingeniero"). The prefix closes the gap with a
   * transform, never with layout, so nothing shifts. When the prefix wraps onto its own line
   * (narrow screens) there is no gap to close.
   */
  const closeGap = (index: number) => {
    if (!ticker || !prefix) return;
    const role = ticker.children[index] as HTMLElement | undefined;
    const sameLine = Math.abs(prefix.offsetTop - ticker.offsetTop) < 4;
    const gap = role && sameLine ? (ticker.offsetWidth - role.offsetWidth) / 2 : 0;
    prefix.style.setProperty('--gap', `${gap.toFixed(1)}px`);
  };
  if (ticker && prefix) {
    void document.fonts.ready.then(() => {
      closeGap(0);
      // Slide only from now on: the first placement must not animate.
      requestAnimationFrame(() => {
        prefix.dataset['measured'] = '';
      });
    });
    new ResizeObserver(() => {
      closeGap(Number(ticker.style.getPropertyValue('--role') || '0'));
    }).observe(ticker.parentElement ?? ticker);
  }

  if (ticker && first && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const last = ticker.childElementCount - 1;
    let index = 0;
    let hovered = false;
    const heading = ticker.closest('h1');
    heading?.addEventListener('pointerenter', () => (hovered = true));
    heading?.addEventListener('pointerleave', () => (hovered = false));

    const tick = () => {
      // Wait while the reader looks at it, or while nobody can see it.
      if (hovered || document.hidden) {
        setTimeout(tick, 600);
        return;
      }
      index += 1;
      ticker.style.setProperty('--role', String(index));
      closeGap(index);
    };
    first.addEventListener('transitionend', () => {
      if (index < last) {
        setTimeout(tick, HOLD_MS);
        return;
      }
      // The copy of the first role is showing: jump back to the real one without a transition.
      ticker.dataset['settled'] = '';
      ticker.style.setProperty('--role', '0');
    });
    setTimeout(tick, HOLD_MS);
  }
</script>

<style>
  /* The painting as a backdrop covering the whole screen, bar included. It is drawn 10 % wider
     than the screen so the figure, not the painting's dark margins, reaches both edges; the
     overflow is cut from the empty top band first and the rest from the bottom, which fades
     into the page. On a phone the crop leans to the left, where the head is. The size comes
     from the screen, not from the section: on a phone the text sets the section's height, and
     it changes when the fonts arrive, which would move the whole backdrop (a layout shift). */
  .hero-art {
    --anchor-x: 0.5;
    --stage: 100svh;
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
  }

  .hero-art :global(.ascii-art) {
    --width: max(var(--stage) * var(--ratio), 110%);
    flex: none;
    width: var(--width);
    margin-inline-start: calc((100% - var(--width)) * var(--anchor-x));
    margin-block-start: calc((var(--stage) - var(--width) / var(--ratio)) * 0.35);
  }

  @media (max-width: 40rem) {
    .hero-art {
      --anchor-x: 0.3;
    }
  }

  .hero-art :global(.ascii-canvas) {
    opacity: 0.5;
    mask-image: linear-gradient(to bottom, black 62%, transparent 100%);
  }

  .hero-art :global(figcaption) {
    position: absolute;
    inset-inline: max(1rem, (100% - 80rem) / 2 + 2rem);
    bottom: 0.75rem;
    margin: 0;
  }

  /* The shade on top keeps the clear bar legible over the glyphs. */
  .hero-veil {
    background:
      linear-gradient(color-mix(in srgb, var(--color-canvas) 75%, transparent), transparent 7rem),
      radial-gradient(
        ellipse 42% 46% at 50% 52%,
        color-mix(in srgb, var(--color-canvas) 72%, transparent),
        transparent 100%
      ),
      radial-gradient(
        50% 60% at 50% 45%,
        color-mix(in srgb, var(--color-accent) 8%, transparent),
        transparent 70%
      );
  }

  .hero :global(.hero-front) {
    pointer-events: none;
    text-shadow:
      0 0 0.35rem var(--color-canvas),
      0 0 1.25rem var(--color-canvas);
  }

  .hero :global(.hero-front > *) {
    pointer-events: auto;
  }

  .hero-actions {
    text-shadow: none;
  }
</style>
