---
import type { Locale } from '../../domain/shared/locale';
import AsciiArt from '../art/AsciiArt.astro';
import type { Dictionary } from '../i18n/dictionary';
import Badge from '../primitives/Badge.astro';
import Button from '../primitives/Button.astro';
import Container from '../primitives/Container.astro';

interface Props {
  t: Dictionary;
  locale: Locale;
  email: string;
  githubUrl: string;
  linkedinUrl: string;
}

const { t, locale, email, githubUrl, linkedinUrl } = Astro.props;
---

<section class="relative overflow-hidden">
  <!-- Candlelight behind the figure: the one light source of the page (chiaroscuro). -->
  <div class="hero-light pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <Container class="relative grid items-center gap-12 pt-10 pb-16 sm:pt-16 lg:min-h-[calc(100svh-4rem)] lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-10 lg:py-12">
    <div class="flex flex-col gap-7">
      <Badge tone="success" status>
        {t.availability.available}
      </Badge>
      <div class="flex flex-col gap-1 text-lead">
        <h1 class="font-medium text-ink">{t.profile.name}</h1>
        <p class="text-muted">{t.hero.intro}</p>
      </div>
      <p class="font-display text-display font-light text-balance">{t.hero.headline}</p>
      <p class="max-w-xl text-lead text-pretty text-muted">{t.hero.pitch}</p>
      <div class="flex flex-wrap gap-3">
        <Button href="#projects" icon="arrow-right" size="lg">
          {t.hero.primaryCta}
        </Button>
        <Button href="#contact" variant="secondary" size="lg">
          {t.hero.secondaryCta}
        </Button>
      </div>
      <ul class="-ms-5 flex flex-wrap items-center gap-1 text-small" aria-label={t.hero.elsewhere}>
        <li>
          <Button
            href={githubUrl}
            variant="ghost"
            icon="github"
            external
            externalLabel={t.a11y.external}
          >
            GitHub
          </Button>
        </li>
        <li>
          <Button
            href={linkedinUrl}
            variant="ghost"
            icon="linkedin"
            external
            externalLabel={t.a11y.external}
          >
            LinkedIn
          </Button>
        </li>
        <li>
          <Button href={`mailto:${email}`} variant="ghost" icon="mail">
            {email}
          </Button>
        </li>
      </ul>
    </div>
    <AsciiArt
      locale={locale}
      alt={t.art.alt}
      caption={t.art.caption}
      characters={t.art.characters}
      lightOn={t.art.lightOn}
      lightOff={t.art.lightOff}
      class="mx-auto w-full max-w-xl lg:max-w-none"
    />
  </Container>
</section>

<style>
  .hero-light {
    background: radial-gradient(
      50% 60% at 78% 38%,
      color-mix(in srgb, var(--color-accent) 9%, transparent),
      transparent 70%
    );
  }
</style>
