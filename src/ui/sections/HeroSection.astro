---
import type { Locale } from '../../domain/shared/locale';
import AsciiArt from '../art/AsciiArt.astro';
import type { Dictionary } from '../i18n/dictionary';
import Badge from '../primitives/Badge.astro';
import Button from '../primitives/Button.astro';
import Container from '../primitives/Container.astro';

interface Props {
  t: Dictionary;
  locale: Locale;
  email: string;
  githubUrl: string;
  linkedinUrl: string;
}

const { t, locale, email, githubUrl, linkedinUrl } = Astro.props;
---

<section class="relative overflow-hidden">
  <!-- Candlelight behind the figure: the one light source of the page (chiaroscuro). -->
  <div class="hero-light pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <Container class="relative grid items-center pt-10 pb-12 sm:pt-16 lg:min-h-[calc(100svh-4rem)] lg:py-12">
    <div class="flex flex-col gap-7 lg:w-[42%]">
      <Badge tone="success" status>
        {t.availability.available}
      </Badge>
      <div class="flex flex-col gap-1 text-lead">
        <h1 class="font-medium text-ink">{t.profile.name}</h1>
        <p class="text-muted">{t.hero.intro}</p>
      </div>
      <p class="font-display text-display font-light text-balance">{t.hero.headline}</p>
      <p class="max-w-xl text-lead text-pretty text-muted">{t.hero.pitch}</p>
      <div class="flex flex-wrap gap-3">
        <Button href="#projects" icon="arrow-right" size="lg">
          {t.hero.primaryCta}
        </Button>
        <Button href="#contact" variant="secondary" size="lg">
          {t.hero.secondaryCta}
        </Button>
      </div>
      <ul class="-ms-5 flex flex-wrap items-center gap-1 text-small" aria-label={t.hero.elsewhere}>
        <li>
          <Button
            href={githubUrl}
            variant="ghost"
            icon="github"
            external
            externalLabel={t.a11y.external}
          >
            GitHub
          </Button>
        </li>
        <li>
          <Button
            href={linkedinUrl}
            variant="ghost"
            icon="linkedin"
            external
            externalLabel={t.a11y.external}
          >
            LinkedIn
          </Button>
        </li>
        <li>
          <Button href={`mailto:${email}`} variant="ghost" icon="mail">
            {email}
          </Button>
        </li>
      </ul>
    </div>
  </Container>
  <div class="hero-art mx-auto max-w-xl px-4 pb-16 sm:px-6">
    <AsciiArt
      locale={locale}
      alt={t.art.alt}
      caption={t.art.caption}
      characters={t.art.characters}
      lightOn={t.art.lightOn}
      lightOff={t.art.lightOff}
      class="w-full"
    />
  </div>
</section>

<style>
  .hero-light {
    background: radial-gradient(
      50% 60% at 72% 48%,
      color-mix(in srgb, var(--color-accent) 9%, transparent),
      transparent 70%
    );
  }

  /* From a laptop up the painting leaves the content column: it takes everything right of the
     text (42 % of the content width) out to the edge of the screen, and the full height of the
     hero, at the largest size whose proportions fit. */
  @media (min-width: 64rem) {
    .hero-art {
      position: absolute;
      inset-block: 0.75rem;
      right: clamp(1rem, 2vw, 2rem);
      /* The content box is at most 80rem wide with 2rem of padding on each side. */
      --gutter: max(2rem, (100vw - 80rem) / 2 + 2rem);
      --text: calc((min(100vw, 80rem) - 4rem) * 0.42);
      left: calc(var(--gutter) + var(--text) + 2.5rem);
      display: flex;
      align-items: center;
      justify-content: flex-end;
      max-width: none;
      margin: 0;
      padding: 0;
      container-type: size;
    }

    .hero-art :global(.ascii-art) {
      /* 4rem is the caption row under the drawing. */
      width: min(100cqw, calc((100cqh - 4rem) * var(--ratio)));
    }
  }
</style>
