---
import type { Dictionary } from '../i18n/dictionary';
import Icon from '../icons/Icon.astro';
import Badge from '../primitives/Badge.astro';
import Button from '../primitives/Button.astro';
import Container from '../primitives/Container.astro';
import Portrait from '../primitives/Portrait.astro';

interface Props {
  t: Dictionary;
  email: string;
  githubUrl: string;
  linkedinUrl: string;
}

const { t, email, githubUrl, linkedinUrl } = Astro.props;
---

<Container
  as="section"
  class="grid gap-12 pt-12 pb-16 sm:pt-20 sm:pb-24 lg:grid-cols-[1fr_22rem] lg:items-end lg:gap-16"
>
  <div class="flex flex-col gap-6">
    <Badge tone="success" status>
      {t.availability.available}
    </Badge>
    <h1 class="text-display font-semibold text-balance">{t.profile.name}</h1>
    <p class="max-w-2xl font-mono text-title text-muted">{t.profile.role}</p>
    <p class="max-w-prose text-lead text-muted">{t.hero.pitch}</p>
    <p class="flex items-center gap-2 text-small text-subtle">
      <Icon name="map-pin" size={16} />
      {t.profile.location}
    </p>
    <div class="flex flex-wrap gap-3">
      <Button href="#projects" icon="arrow-right" size="lg">
        {t.hero.primaryCta}
      </Button>
      <Button href="#contact" variant="secondary" size="lg">
        {t.hero.secondaryCta}
      </Button>
    </div>
    <ul
      class="flex flex-wrap items-center gap-2 text-small text-muted"
      aria-label={t.hero.elsewhere}
    >
      <li>
        <Button
          href={githubUrl}
          variant="ghost"
          icon="github"
          external
          externalLabel={t.a11y.external}
        >
          GitHub
        </Button>
      </li>
      <li>
        <Button
          href={linkedinUrl}
          variant="ghost"
          icon="linkedin"
          external
          externalLabel={t.a11y.external}
        >
          LinkedIn
        </Button>
      </li>
      <li>
        <Button href={`mailto:${email}`} variant="ghost" icon="mail">
          {email}
        </Button>
      </li>
    </ul>
  </div>
  <Portrait alt={t.profile.portraitAlt} initials="JC" priority class="max-w-sm" />
</Container>
