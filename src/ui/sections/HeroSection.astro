---
import type { Locale } from '../../domain/shared/locale';
import AsciiArt from '../art/AsciiArt.astro';
import type { Dictionary } from '../i18n/dictionary';
import Icon from '../icons/Icon.astro';
import Badge from '../primitives/Badge.astro';
import Button from '../primitives/Button.astro';
import Container from '../primitives/Container.astro';

interface Props {
  t: Dictionary;
  locale: Locale;
  email: string;
  githubUrl: string;
  linkedinUrl: string;
}

const { t, locale, email, githubUrl, linkedinUrl } = Astro.props;
---

<!--
  Two layers: the painting fills the hero as a backdrop, the content stands centred in front of
  it. The lamp follows the pointer anywhere on the stage (data-ascii-stage).
-->
<section class="hero relative isolate overflow-hidden" data-ascii-stage>
  <div class="hero-art">
    <AsciiArt
      locale={locale}
      alt={t.art.alt}
      caption={t.art.caption}
      characters={t.art.characters}
      lightOn={t.art.lightOn}
      lightOff={t.art.lightOff}
    />
  </div>
  <!-- A pool of shadow behind the text, so it reads over the brightest paint. -->
  <div class="hero-veil pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <Container class="hero-front relative flex min-h-[calc(100svh-4rem)] flex-col items-center justify-center gap-7 pt-16 pb-28 text-center">
    <Badge tone="success" status>
      {t.availability.available}
    </Badge>
    <div class="flex flex-col items-center gap-x-2 gap-y-1 text-lead sm:flex-row sm:flex-wrap sm:justify-center">
      <h1 class="font-medium text-ink">{t.profile.name}</h1>
      <span class="hidden text-muted sm:inline" aria-hidden="true">
        ·
      </span>
      <p class="text-muted">{t.hero.intro}</p>
    </div>
    <p class="max-w-4xl font-display text-display font-light text-balance">{t.hero.headline}</p>
    <p class="max-w-2xl text-lead text-pretty text-muted">{t.hero.pitch}</p>
    <div class="hero-actions flex flex-wrap justify-center gap-3">
      <Button href="#projects" icon="arrow-right" size="lg">
        {t.hero.primaryCta}
      </Button>
      <Button href="#contact" variant="secondary" size="lg">
        {t.hero.secondaryCta}
      </Button>
    </div>
    <ul
      class="flex flex-wrap items-center justify-center gap-1 text-small"
      aria-label={t.hero.elsewhere}
    >
      <li>
        <Button
          href={githubUrl}
          variant="ghost"
          icon="github"
          external
          externalLabel={t.a11y.external}
        >
          GitHub
        </Button>
      </li>
      <li>
        <Button
          href={linkedinUrl}
          variant="ghost"
          icon="linkedin"
          external
          externalLabel={t.a11y.external}
        >
          LinkedIn
        </Button>
      </li>
      <li>
        <Button href={`mailto:${email}`} variant="ghost" icon="mail">
          {email}
        </Button>
      </li>
    </ul>
    <a
      href="#projects"
      class="mt-4 hidden min-h-11 items-center gap-4 text-small text-muted transition-colors duration-150 hover:text-ink lg:flex"
    >
      <span>{t.hero.scrollLead}</span>
      <span class="h-px w-28 bg-line-strong" aria-hidden="true"></span>
      <Icon name="mouse" size={22} />
      <span class="h-px w-28 bg-line-strong" aria-hidden="true"></span>
      <span>{t.hero.scrollTail}</span>
    </a>
  </Container>
</section>

<style>
  /* The painting as a backdrop covering the hero. It always fills the height and grows towards
     the full width, overflowing by at most 12 % of its height; the overflow is cut mostly from
     the bottom, which fades into the page, so the head stays whole. On a phone the crop leans
     to the left, where the head is. */
  .hero-art {
    --anchor-x: 0.5;
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    container-type: size;
  }

  .hero-art :global(.ascii-art) {
    /* --ratio is set on the figure itself, so the size is worked out here. */
    --width: clamp(100cqh * var(--ratio), 100cqw, 112cqh * var(--ratio));
    flex: none;
    width: var(--width);
    margin-inline-start: calc((100cqw - var(--width)) * var(--anchor-x));
    margin-block-start: calc((100cqh - var(--width) / var(--ratio)) * 0.25);
  }

  @media (max-width: 40rem) {
    .hero-art {
      --anchor-x: 0.3;
    }
  }

  /* Behind the text the figure is a presence, not a picture: dimmer, fading into the ground at
     its edges. The lamp and the switch let its colours through. */
  .hero-art :global(.ascii-canvas) {
    opacity: 0.55;
    /* Fades at the sides and into the page below, where the water (the reflection) would be. */
    mask-image:
      linear-gradient(to bottom, black 62%, transparent 100%),
      linear-gradient(to right, transparent, black 12% 88%, transparent);
    mask-composite: intersect;
  }

  /* The caption and the switch sit on the bottom edge of the hero, aligned with the content. */
  .hero-art :global(figcaption) {
    position: absolute;
    inset-inline: max(1rem, (100% - 80rem) / 2 + 2rem);
    bottom: 0.75rem;
    margin: 0;
  }

  .hero-veil {
    background:
      radial-gradient(
        ellipse 40% 46% at 50% 48%,
        color-mix(in srgb, var(--color-canvas) 70%, transparent),
        transparent 100%
      ),
      radial-gradient(
        50% 60% at 50% 42%,
        color-mix(in srgb, var(--color-accent) 8%, transparent),
        transparent 70%
      );
  }

  /* The front layer lets clicks through to the painting between its blocks. Container renders
     it, so the rule reaches it from the section. */
  .hero :global(.hero-front) {
    pointer-events: none;
    /* A halo of the ground colour lifts the text off the glyphs behind it, in both themes. */
    text-shadow:
      0 0 0.35rem var(--color-canvas),
      0 0 1.25rem var(--color-canvas);
  }

  .hero :global(.hero-front > *) {
    pointer-events: auto;
  }

  /* The filled buttons carry their own ground; a dark halo on them would only lower contrast. */
  .hero-actions {
    text-shadow: none;
  }
</style>
