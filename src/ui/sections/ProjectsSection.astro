---
import type { Project } from '../../domain/project/project';
import type { Dictionary } from '../i18n/dictionary';
import Container from '../primitives/Container.astro';
import ProjectCard from '../project/ProjectCard.astro';
import ProjectStage from '../project/ProjectStage.astro';

/**
 * Projects that open their own page. Featured projects play one at a time on the pinned stage
 * (ProjectStage); the rest share a grid of smaller cards below it. Both lists keep the display
 * order set in the content (`order`).
 */
interface Props {
  t: Dictionary;
  projects: readonly Project[];
}

const { t, projects } = Astro.props;
const featured = projects.filter((project) => project.featured);
const others = projects.filter((project) => !project.featured);
---

<section id="projects" aria-labelledby="projects-title" class="scroll-mt-24 py-20 sm:py-28">
  {projects.length === 0 ? (
    <Container>
      <h2 id="projects-title" class="mb-12 font-display text-heading font-light text-balance">
        {t.projects.featuredTitle}
      </h2>
      <p class="rounded-card border border-dashed border-line-strong p-8 text-muted">
        {t.projects.empty}
      </p>
    </Container>
  ) : (
    <>
      <ProjectStage t={t} projects={featured} headingId="projects-title" />

      {others.length > 0 && (
        <Container class="pt-16 lg:pt-24">
          <section aria-labelledby="more-projects-title" class="flex scroll-mt-24 flex-col gap-6">
            <h3
              id="more-projects-title"
              class="scroll-mt-24 font-display text-title font-light text-ink"
            >
              {t.projects.moreTitle}
            </h3>
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {others.map((project, index) => (
                <ProjectCard
                  t={t}
                  project={project}
                  variant="compact"
                  tone={index % 2 === 0 ? 'success' : 'accent'}
                />
              ))}
            </div>
          </section>
        </Container>
      )}
    </>
  )}
</section>
