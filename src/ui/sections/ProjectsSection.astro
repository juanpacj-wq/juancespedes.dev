---
import type { Project } from '../../domain/project/project';
import type { Dictionary } from '../i18n/dictionary';
import ProjectCard from '../project/ProjectCard.astro';
import Section from '../primitives/Section.astro';

/**
 * Projects as cards that open their own page. Featured projects get the wide case-study card
 * with their figures; the rest share a grid of smaller cards. Both lists keep the display order
 * set in the content (`order`).
 */
interface Props {
  t: Dictionary;
  projects: readonly Project[];
}

const { t, projects } = Astro.props;
const featured = projects.filter((project) => project.featured);
const others = projects.filter((project) => !project.featured);
---

<Section id="projects" title={t.projects.featuredTitle}>
  <p slot="description">{t.projects.description}</p>

  {projects.length === 0 ? (
    <p class="rounded-card border border-dashed border-line-strong p-8 text-muted">
      {t.projects.empty}
    </p>
  ) : (
    <div class="flex flex-col gap-8 lg:gap-12">
      {featured.map((project, index) => (
        <ProjectCard t={t} project={project} tone={index % 2 === 0 ? 'accent' : 'success'} />
      ))}

      {others.length > 0 && (
        <section aria-labelledby="more-projects-title" class="flex flex-col gap-6 pt-8">
          <h3 id="more-projects-title" class="font-display text-title font-light text-ink">
            {t.projects.moreTitle}
          </h3>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {others.map((project, index) => (
              <ProjectCard
                t={t}
                project={project}
                variant="compact"
                tone={index % 2 === 0 ? 'success' : 'accent'}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  )}
</Section>
