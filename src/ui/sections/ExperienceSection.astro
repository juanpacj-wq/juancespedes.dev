---
import type { Locale } from '../../domain/shared/locale';
import type { Education, Experience } from '../../domain/profile/profile';
import type { Dictionary } from '../i18n/dictionary';
import { formatPeriod } from '../i18n/format';
import Section from '../primitives/Section.astro';

interface Props {
  t: Dictionary;
  locale: Locale;
  experience: readonly Experience[];
  education: readonly Education[];
}

const { t, locale, experience, education } = Astro.props;
---

<Section id="experience" title={t.experience.title}>
  <h3 class="mb-4 font-mono text-eyebrow tracking-widest text-subtle uppercase">
    {t.experience.work}
  </h3>
  <ol class="mb-12 border-t border-line">
    {experience.map((job) => (
      <li class="grid gap-3 border-b border-line py-8 md:grid-cols-[12rem_1fr] md:gap-8">
        <p class="font-mono text-small text-subtle">{formatPeriod(locale, job.period, t)}</p>
        <div class="flex flex-col gap-3">
          <div>
            <p class="text-title font-medium">{job.role}</p>
            <p class="text-muted">
              {job.organization} · {job.location}
            </p>
          </div>
          <p class="max-w-prose text-muted">{job.summary}</p>
          <ul class="flex max-w-prose list-disc flex-col gap-2 pl-5 text-muted marker:text-accent-ink">
            {job.highlights.map((highlight) => (
              <li>{highlight}</li>
            ))}
          </ul>
        </div>
      </li>
    ))}
  </ol>

  <h3 class="mb-4 font-mono text-eyebrow tracking-widest text-subtle uppercase">
    {t.experience.education}
  </h3>
  <ol class="border-t border-line">
    {education.map((item) => (
      <li class="grid gap-3 border-b border-line py-6 md:grid-cols-[12rem_1fr] md:gap-8">
        <p class="font-mono text-small text-subtle">{formatPeriod(locale, item.period, t)}</p>
        <div>
          <p class="text-title font-medium">{item.degree}</p>
          <p class="text-muted">{item.institution}</p>
        </div>
      </li>
    ))}
  </ol>
</Section>
