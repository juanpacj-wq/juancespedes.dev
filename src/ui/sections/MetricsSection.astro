---
import type { HeadlineMetric } from '../../domain/project/metric';
import type { Dictionary } from '../i18n/dictionary';
import Card from '../primitives/Card.astro';
import Section from '../primitives/Section.astro';
import Stat from '../primitives/Stat.astro';

interface Props {
  t: Dictionary;
  metrics: readonly HeadlineMetric[];
}

const { t, metrics } = Astro.props;
---

{metrics.length > 0 && (
  <Section id="metrics" eyebrow={t.metrics.eyebrow} title={t.metrics.title}>
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {metrics.map((metric, index) => (
        <li class:list={[index === 0 && 'sm:col-span-2 lg:row-span-2']}>
          <Card class="h-full" padding={index === 0 ? 'lg' : 'md'}>
            <Stat
              value={metric.value}
              label={metric.label}
              source={metric.source}
              sourceLabel={t.metric.source}
              size={index === 0 ? 'lg' : 'md'}
            />
          </Card>
        </li>
      ))}
    </ul>
  </Section>
)}
