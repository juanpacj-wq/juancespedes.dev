---
import type { Dictionary } from '../i18n/dictionary';
import Portrait from '../primitives/Portrait.astro';
import Section from '../primitives/Section.astro';

/**
 * The person behind the work. The portrait frame holds the photo once it exists; until then it
 * holds a profile card instead of a monogram: the live time in Barranquilla, where it is on the
 * map and the working facts a client asks first. Same 4:5 frame, so the photo drops in without
 * moving the layout.
 */
interface Props {
  t: Dictionary;
}

const { t } = Astro.props;
const [lead, ...rest] = t.about.paragraphs;
const card = t.about.card;
---

<Section id="about" title={t.about.title}>
  <div class="grid gap-10 md:grid-cols-12 md:gap-10">
    <div class="reveal max-w-sm md:col-span-5 lg:col-span-4 xl:col-span-3">
      <Portrait alt={t.profile.portraitAlt} initials="JC">
        <div slot="fallback" class="about-card flex size-full flex-col justify-between p-6 sm:p-7">
          <div class="flex items-center justify-between font-mono text-eyebrow tracking-widest text-subtle uppercase">
            <span>{card.label}</span>
            <span aria-hidden="true">10.96° N · 74.80° W</span>
          </div>

          <div class="flex flex-col gap-2">
            <p class="text-title font-medium text-ink">{t.profile.name}</p>
            <p class="flex items-baseline gap-3">
              <time
                class="font-display text-heading leading-none font-medium text-ink tabular-nums"
                data-clock-time
              >
                --:--
              </time>
            </p>
            <p class="flex items-center gap-2 font-mono text-eyebrow text-muted">
              <span class="relative flex size-2" aria-hidden="true">
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-success opacity-60"></span>
                <span class="relative inline-flex size-2 rounded-full bg-success"></span>
              </span>
              {t.about.localTime} · {card.timezone}
            </p>
          </div>

          <dl class="flex flex-col border-t border-line">
            {card.facts.map(([term, value]) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-line py-2.5 text-small">
                <dt class="text-subtle">{term}</dt>
                <dd class="text-right text-ink">{value}</dd>
              </div>
            ))}
          </dl>
        </div>
      </Portrait>
    </div>
    <div class="reveal flex max-w-4xl flex-col gap-6 self-center md:col-span-7 lg:col-span-8 xl:col-span-8 xl:col-start-5">
      {lead && <p class="font-display text-quote font-medium text-pretty">{lead}</p>}
      {rest.map((paragraph) => (
        <p class="text-lead text-pretty text-muted">{paragraph}</p>
      ))}
    </div>
  </div>
</Section>

<script>
  // Local time in Barranquilla, refreshed every half minute. Without JavaScript it shows dashes.
  const format = new Intl.DateTimeFormat(document.documentElement.lang || 'es', {
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/Bogota',
  });
  for (const time of document.querySelectorAll<HTMLTimeElement>('[data-clock-time]')) {
    const tick = (): void => {
      const now = new Date();
      time.dateTime = now.toISOString();
      time.textContent = format.format(now);
    };
    tick();
    window.setInterval(tick, 30_000);
  }
</script>
