---
import type { Education, Experience } from '../../domain/profile/profile';
import type { Dictionary } from '../i18n/dictionary';
import { formatYears } from '../i18n/format';
import Portrait from '../primitives/Portrait.astro';
import { portraitPhoto } from '../primitives/portrait-photo';
import Section from '../primitives/Section.astro';

/**
 * The person behind the work, told the way photo-less portfolios tell it (Brittany Chiang, Rauno
 * Freiberg): a statement on the left and a hairline timeline on the right, in the same rows as
 * the results and the certifications. No placeholder stands in for the face. Once
 * src/assets/photos/portrait.* exists, the photo takes a column of its own.
 */
interface Props {
  t: Dictionary;
  experience: readonly Experience[];
  education: readonly Education[];
}

const { t, experience, education } = Astro.props;
const [lead, ...rest] = t.about.paragraphs;

const groups = [
  {
    title: t.about.experience,
    rows: experience.map((job) => ({
      years: formatYears(job.period, t),
      title: job.role,
      place: job.organization,
      note: job.summary,
    })),
  },
  {
    title: t.about.education,
    rows: education.map((study) => ({
      years: formatYears(study.period, t),
      title: study.degree,
      place: study.institution,
      note: null,
    })),
  },
].filter((group) => group.rows.length > 0);
---

<Section id="about" title={t.about.title}>
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="reveal flex flex-col gap-6 lg:col-span-7">
      {portraitPhoto && (
        <div class="max-w-56">
          <Portrait alt={t.profile.portraitAlt} initials="JC" />
        </div>
      )}
      {lead && <p class="font-display text-quote font-medium text-balance text-ink">{lead}</p>}
      {rest.map((paragraph) => (
        <p class="max-w-2xl text-lead text-pretty text-muted">{paragraph}</p>
      ))}
      <p class="flex items-center gap-2 font-mono text-eyebrow tracking-widest text-subtle uppercase">
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-success opacity-60"></span>
          <span class="relative inline-flex size-2 rounded-full bg-success"></span>
        </span>
        {t.about.basedIn}
        <time class="text-muted tabular-nums" data-clock-time>
          --:--
        </time>
      </p>
    </div>

    <div class="reveal flex flex-col gap-10 lg:col-span-5">
      {groups.map((group) => (
        <section aria-label={group.title}>
          <h3 class="font-mono text-eyebrow tracking-widest text-subtle uppercase">
            {group.title}
          </h3>
          <ol class="mt-4 border-t border-line">
            {group.rows.map((row) => (
              <li class="grid gap-1 border-b border-line py-4 sm:grid-cols-[7rem_minmax(0,1fr)] sm:gap-6">
                <span class="font-mono text-small text-subtle tabular-nums">{row.years}</span>
                <div class="flex flex-col gap-1">
                  <p class="font-medium text-ink">
                    {row.title}
                    <span class="text-muted"> · {row.place}</span>
                  </p>
                  {row.note && <p class="text-small text-pretty text-muted">{row.note}</p>}
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </div>
</Section>

<script>
  // Local time in Barranquilla, refreshed every half minute. Without JavaScript it shows dashes.
  const format = new Intl.DateTimeFormat(document.documentElement.lang || 'es', {
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/Bogota',
  });
  for (const time of document.querySelectorAll<HTMLTimeElement>('[data-clock-time]')) {
    const tick = (): void => {
      const now = new Date();
      time.dateTime = now.toISOString();
      time.textContent = format.format(now);
    };
    tick();
    window.setInterval(tick, 30_000);
  }
</script>
