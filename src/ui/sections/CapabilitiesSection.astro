---
import type { Capability } from '../../domain/project/capability';
import type { Dictionary } from '../i18n/dictionary';
import { logoFor, monogramFor, rasterLogoFor, techId } from '../icons/tech-logos';
import Section from '../primitives/Section.astro';

/**
 * The stack, one row per area: the area's name on the left, its technologies as logos on the
 * right. Which project used each one is told by the case studies, so the section only says what
 * the owner works with; the page shape (the skill-evidence use case) still keeps out any
 * technology no visible project uses.
 *
 * The logos come from one sprite (src/pages/tech-logos.svg.ts) whose address waits in
 * `data-href` until the section comes within a screen: the section sits below the first screen,
 * so the logos never compete with the first paint and add nothing to the HTML (CLAUDE.md, the
 * performance budget). Each logo wears its brand colour where it keeps 3:1 against the canvas
 * (global.css, `.stack-*`). A brand Simple Icons lacks shows its own small raster logo
 * (public/tech), held in `data-src` the same way; anything else shows a monogram.
 */
export interface CapabilityStackView {
  readonly capability: Capability;
  readonly technologies: readonly { readonly name: string }[];
}

interface Props {
  t: Dictionary;
  matrix: readonly CapabilityStackView[];
}

const { t, matrix } = Astro.props;
const sprite = '/tech-logos.svg';
const rows = matrix
  .filter((row) => row.technologies.length > 0)
  .map((row, index) => ({
    capability: row.capability,
    number: String(index + 1).padStart(2, '0'),
    technologies: row.technologies.map(({ name }) => ({
      name,
      id: techId(name),
      logo: logoFor(name),
      raster: rasterLogoFor(name),
      monogram: monogramFor(name),
    })),
  }));
---

{rows.length > 0 && (
  <Section id="capabilities" title={t.capabilities.title}>
    <div data-stack>
      {rows.map((row) => (
        <div class="stack-row reveal grid gap-6 border-b border-line py-8 lg:grid-cols-12 lg:gap-10">
          <div class="flex items-baseline gap-4 lg:col-span-4 lg:flex-col lg:gap-3">
            <span class="stack-number font-mono text-eyebrow tracking-widest text-subtle tabular-nums">
              {row.number}
            </span>
            <h3 class="text-title font-medium text-balance text-ink">
              {t.capabilityLabels[row.capability]}
            </h3>
          </div>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-4 sm:grid-cols-3 lg:col-span-8 xl:grid-cols-4 2xl:grid-cols-5">
            {row.technologies.map((technology) => (
              <li
                class="stack-item flex min-w-0 items-center gap-3"
                style={technology.logo ? `--brand:#${technology.logo.hex}` : undefined}
                data-on-dark={technology.logo?.onDark ? '' : undefined}
                data-on-light={technology.logo?.onLight ? '' : undefined}
              >
                <span
                  class="stack-tile grid size-12 shrink-0 place-items-center rounded-control bg-surface shadow-bevel"
                  aria-hidden="true"
                >
                  {technology.logo ? (
                    <svg viewBox="0 0 24 24" class="stack-logo size-6">
                      <use data-href={`${sprite}#${technology.id}`} />
                    </svg>
                  ) : technology.raster ? (
                    <img
                      data-src={technology.raster}
                      alt=""
                      width="24"
                      height="24"
                      decoding="async"
                      class="size-6 object-contain"
                    />
                  ) : (
                    <span class="stack-monogram font-mono text-eyebrow text-muted">
                      {technology.monogram}
                    </span>
                  )}
                </span>
                <span class="stack-name font-mono text-eyebrow leading-snug tracking-wider text-pretty text-muted uppercase">
                  {technology.name}
                </span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>
)}

<script>
  /*
   * The logos load when the section comes within a screen of the viewport, the way the project
   * cards load their screenshots: a visit that lands on the section loads them at once.
   */
  const load = () => {
    for (const use of document.querySelectorAll<SVGUseElement>('use[data-href]')) {
      use.setAttribute('href', use.dataset.href ?? '');
    }
    for (const img of document.querySelectorAll<HTMLImageElement>('[data-stack] img[data-src]')) {
      img.src = img.dataset.src ?? '';
    }
  };
  const stack = document.querySelector('[data-stack]');
  if (stack && 'IntersectionObserver' in window) {
    const watch = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        watch.disconnect();
        load();
      },
      { rootMargin: '100% 0px' },
    );
    watch.observe(stack);
  } else {
    load();
  }
</script>
