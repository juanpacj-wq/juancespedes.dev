---
import type { Credential } from '../../domain/profile/profile';
import type { Locale } from '../../domain/shared/locale';
import type { Dictionary } from '../i18n/dictionary';
import { formatYearMonth } from '../i18n/format';
import Section from '../primitives/Section.astro';
import TextLink from '../primitives/TextLink.astro';

interface Props {
  t: Dictionary;
  locale: Locale;
  credentials: readonly Credential[];
}

const { t, locale, credentials } = Astro.props;
const sorted = [...credentials].sort((a, b) => b.issued.localeCompare(a.issued));
---

{sorted.length > 0 && (
  <Section id="credentials" eyebrow={t.credentials.eyebrow} title={t.credentials.title}>
    <ul class="grid gap-x-8 border-t border-line md:grid-cols-2">
      {sorted.map((credential) => (
        <li class="flex items-baseline justify-between gap-4 border-b border-line py-4">
          <div>
            <p class="font-medium">{credential.name}</p>
            <p class="text-small text-muted">{credential.issuer}</p>
          </div>
          <div class="flex shrink-0 flex-col items-end gap-1 text-right">
            <span class="font-mono text-small text-subtle">
              {formatYearMonth(locale, credential.issued)}
            </span>
            {credential.url && (
              <TextLink
                href={credential.url}
                external
                externalLabel={t.a11y.external}
                class="text-small"
              >
                {t.credentials.verify}
              </TextLink>
            )}
          </div>
        </li>
      ))}
    </ul>
  </Section>
)}
