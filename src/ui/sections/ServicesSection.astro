---
import type { Currency, ProcessStep, Service } from '../../domain/profile/profile';
import type { Locale } from '../../domain/shared/locale';
import type { Dictionary } from '../i18n/dictionary';
import { formatMoney } from '../i18n/format';
import Icon from '../icons/Icon.astro';
import Button from '../primitives/Button.astro';
import Frame from '../primitives/Frame.astro';
import Section from '../primitives/Section.astro';

/**
 * Services with their starting prices, so a visitor knows the order of magnitude at a glance
 * without a rigid price list: every amount is a floor ("from"), each service names its scope
 * in one human unit, and every card leads to the same conversation (ADR 0018). A service
 * without a floor is quoted per requirement and says so in place of the amount.
 */
interface Props {
  t: Dictionary;
  locale: Locale;
  services: readonly Service[];
  process: readonly ProcessStep[];
  currency: Currency;
  pricing: string;
}

const { t, locale, services, process, currency, pricing } = Astro.props;
---

<Section id="services" title={t.services.title}>
  <p slot="description">{t.services.description}</p>

  <ul class="grid gap-4 lg:grid-cols-3">
    {services.map((service, index) => (
      <li class="reveal flex">
        <Frame class="w-full" inverted={service.featured}>
          <h3 slot="label" class="font-medium text-ink" id={`service-${String(index)}`}>
            {service.title}
          </h3>
          {service.featured && (
            <span
              slot="badge"
              class="inline-flex min-h-7 items-center rounded-chip bg-accent px-3 text-eyebrow font-medium text-on-accent"
            >
              {t.services.featured}
            </span>
          )}
          {service.price.from === null ? (
            <p class="text-price font-semibold text-balance">{t.services.quoted}</p>
          ) : (
            <p class="flex flex-wrap items-baseline gap-x-2">
              <span
                class:list={['text-small', service.featured ? 'text-canvas/70' : 'text-subtle']}
              >
                {t.services.from}
              </span>
              <span class="text-price font-semibold tabular-nums">
                {formatMoney(locale, service.price.from, currency)}
              </span>
              <span
                class:list={['text-small', service.featured ? 'text-canvas/70' : 'text-subtle']}
              >
                {currency}
              </span>
            </p>
          )}
          <p
            class:list={[
              'mt-4 text-small text-pretty',
              service.featured ? 'text-canvas/80' : 'text-muted',
            ]}
          >
            {service.summary}
          </p>
          <div
            class:list={[
              'mt-6 border-t pt-4',
              service.featured ? 'border-canvas/15' : 'border-line',
            ]}
          >
            <p class:list={['text-eyebrow', service.featured ? 'text-canvas/70' : 'text-subtle']}>
              {t.services.scope}
            </p>
            <p class="mt-1 text-title font-semibold">{service.price.scope}</p>
          </div>
          <ul
            class="mt-6 flex flex-1 flex-col gap-3 text-small"
            aria-label={t.services.deliverables}
          >
            {service.deliverables.map((deliverable) => (
              <li class="flex items-start gap-3">
                <span
                  class:list={[
                    'mt-px inline-flex size-6 shrink-0 items-center justify-center rounded-chip',
                    service.featured
                      ? 'bg-accent text-on-accent'
                      : 'bg-surface-raised text-success',
                  ]}
                  aria-hidden="true"
                >
                  <Icon name="check" size={14} />
                </span>
                {deliverable}
              </li>
            ))}
          </ul>
          <Button
            href="#contact"
            variant={service.featured ? 'primary' : 'secondary'}
            class="mt-8 w-full"
            aria-describedby={`service-${String(index)}`}
          >
            {t.services.cta}
          </Button>
        </Frame>
      </li>
    ))}
  </ul>
  <p class="mt-6 text-center text-small text-pretty text-subtle">
    {pricing} {t.services.currencyNote}
  </p>

  <h3 class="mt-20 mb-8 font-display text-title font-light sm:text-heading">
    {t.services.processTitle}
  </h3>
  <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {process.map((step, index) => (
      <li class="reveal flex flex-col gap-2 border-t border-line-strong pt-4">
        <span class="font-mono text-small text-accent-ink">
          {String(index + 1).padStart(2, '0')}
        </span>
        <span class="font-medium">{step.title}</span>
        <span class="text-small text-muted">{step.description}</span>
      </li>
    ))}
  </ol>
</Section>
