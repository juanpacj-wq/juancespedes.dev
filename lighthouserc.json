{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/preview-compressed.mjs --port 4331",
      "startServerReadyPattern": "compressed preview on",
      "url": [
        "http://localhost:4331/",
        "http://localhost:4331/design-system",
        "http://localhost:4331/privacidad",
        "http://localhost:4331/proyectos/plant-telemetry",
        "http://localhost:4331/en",
        "http://localhost:4331/en/projects/plant-telemetry"
      ],
      "numberOfRuns": 3,
      "settings": {}
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "^(?!.*design-system).*$",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "design-system",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 1
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
