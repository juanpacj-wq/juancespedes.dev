{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "juancespedes-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  // The custom domain is declared here, not clicked in the dashboard, so it is versioned.
  "routes": [{ "pattern": "juancespedes.dev", "custom_domain": true }],
  // Pull requests get a unique preview URL per uploaded version.
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
}
