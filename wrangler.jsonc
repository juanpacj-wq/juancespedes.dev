{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "name": "juancespedes-dev",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  // The custom domain is declared here, not clicked in the dashboard, so it is versioned.
  "routes": [{ "pattern": "juancespedes.dev", "custom_domain": true }],
  // Pull requests get a unique preview URL per uploaded version.
  "workers_dev": true,
  "preview_urls": true,
  // Contact form delivery: Email Routing can only send to this verified address.
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "juanpablocespedesj@gmail.com" },
  ],
  // At most 5 contact submissions per minute per IP.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
    // Browser error reports (ADR 0013): at most 10 per minute per IP, so a loop cannot flood logs.
    {
      "name": "CLIENT_ERROR_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
    // "Ask me" chat (ADR 0017): at most 3 questions per minute per visitor; the daily quotas
    // live in CHAT_QUOTA.
    {
      "name": "CHAT_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 3, "period": 60 },
    },
  ],
  // Daily question counters for the chat, per anonymized visitor and for the whole site.
  "kv_namespaces": [{ "binding": "CHAT_QUOTA", "id": "fdf95983768546a998eb92b105a63424" }],
  "observability": {
    "enabled": true,
  },
}
